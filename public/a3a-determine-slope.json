{
  "module_id":"alg1-a3a-determine-slope",
  "version":"1.0.0-private-qa",
  "course":"Algebra 1",
  "teks":["A.3A"],
  "title":"Determine Slope",
  "student_objective":"I can determine slope from graphs, tables, points, and equations and explain it as rise over run.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A3A-D01","A3A-D02"],"guided_item_ids":["A3A-G01","A3A-G02","A3A-G03"],"independent_item_ids":["A3A-P01","A3A-P02","A3A-P03"],"mastery_item_ids":["A3A-M01","A3A-M02","A3A-M03","A3A-M04","A3A-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Slope readiness"},{"step":2,"type":"concept","label":"See slope as rise over run"},{"step":3,"type":"worked_examples","label":"Watch Tolux find slope four ways"},{"step":4,"type":"guided_practice","label":"Find slope with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A3A-C01","title":"Slope is rise over run","content":"Slope measures vertical change divided by horizontal change: m=(y₂-y₁)/(x₂-x₁). On a graph, count rise first and run second."},
    {"id":"A3A-C02","title":"From two points","content":"Subtract y-values in the same order as x-values. Keeping the subtraction order consistent prevents sign errors."},
    {"id":"A3A-C03","title":"From a table","content":"Use change in output divided by change in input. A constant rate of change confirms a linear relationship."},
    {"id":"A3A-C04","title":"From an equation","content":"In y=mx+b, m is the slope. In standard form Ax+By=C, rewrite as y=mx+b or compare changes carefully."}
  ],
  "misconception_routes":{
    "rise_run":{"route":"graph","error_code":"SLOPE-RUN","teacher_signal":"Student reverses rise and run."},
    "sign":{"route":"sign","error_code":"SLOPE-SIGN","teacher_signal":"Student loses the sign of the slope."},
    "points":{"route":"points","error_code":"SLOPE-POINTS","teacher_signal":"Student subtracts coordinates in inconsistent order."},
    "equation":{"route":"equation","error_code":"SLOPE-EQ","teacher_signal":"Student identifies the intercept instead of the slope."}
  },
  "items":[
    {"id":"A3A-D01","type":"diagnostic","difficulty":"Foundational","prompt":"From (1,2) to (4,8), what is the rise?","answer_key":"6","accepted_answers":["6","+6"],"diagnostic_tag":"rise_run","tutor_behavior":"Rise is change in y.","hint_steps":["Use y₂-y₁.","8-2=6.","Rise=6."],"solution_steps":[{"equation":"rise=8-2","explanation":"Subtract y-values."},{"equation":"rise=6","explanation":"Vertical change."}]},
    {"id":"A3A-D02","type":"diagnostic","difficulty":"Foundational","prompt":"From (1,2) to (4,8), what is the run?","answer_key":"3","accepted_answers":["3","+3"],"diagnostic_tag":"rise_run","tutor_behavior":"Run is change in x.","hint_steps":["Use x₂-x₁.","4-1=3.","Run=3."],"solution_steps":[{"equation":"run=4-1","explanation":"Subtract x-values."},{"equation":"run=3","explanation":"Horizontal change."}]},
    {"id":"A3A-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Find the slope through (1,2) and (4,8).","answer_key":"2","accepted_answers":["2","2/1"],"diagnostic_tag":"points","tutor_behavior":"Use m=(y₂-y₁)/(x₂-x₁).","hint_steps":["Rise=8-2=6.","Run=4-1=3.","m=6/3=2."],"solution_steps":[{"equation":"m=(8-2)/(4-1)","explanation":"Substitute the points."},{"equation":"m=6/3","explanation":"Simplify differences."},{"equation":"m=2","explanation":"Reduce."}]},
    {"id":"A3A-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Find the slope through (-2,5) and (2,-3).","answer_key":"-2","accepted_answers":["-2","-2/1"],"diagnostic_tag":"sign","tutor_behavior":"A line that falls left to right has negative slope.","hint_steps":["Change in y=-3-5=-8.","Change in x=2-(-2)=4.","m=-8/4=-2."],"solution_steps":[{"equation":"m=(-3-5)/(2-(-2))","explanation":"Use consistent subtraction."},{"equation":"m=-8/4=-2","explanation":"Reduce."}]},
    {"id":"A3A-L03","type":"worked_example","difficulty":"Grade-level","prompt":"A table has x-values 0,2,4 and y-values 1,7,13. Find the slope.","answer_key":"3","accepted_answers":["3","3/1"],"diagnostic_tag":"rise_run","tutor_behavior":"Use change in y divided by change in x.","hint_steps":["Δy=7-1=6.","Δx=2-0=2.","m=6/2=3."],"solution_steps":[{"equation":"m=(7-1)/(2-0)","explanation":"Use two rows."},{"equation":"m=6/2=3","explanation":"Simplify."}]},
    {"id":"A3A-G01","type":"guided_practice","difficulty":"Grade-level","prompt":"Find the slope through (0,-1) and (5,9).","answer_key":"2","accepted_answers":["2"],"diagnostic_tag":"points","tutor_behavior":"Compute rise over run.","hint_steps":["Rise=10.","Run=5.","m=2."],"solution_steps":[{"equation":"m=(9-(-1))/(5-0)","explanation":"Substitute."},{"equation":"m=10/5=2","explanation":"Simplify."}]},
    {"id":"A3A-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Find the slope through (-3,-2) and (1,6).","answer_key":"2","accepted_answers":["2"],"diagnostic_tag":"points","tutor_behavior":"Use the same subtraction order in numerator and denominator.","hint_steps":["Rise=6-(-2)=8.","Run=1-(-3)=4.","m=8/4=2."],"solution_steps":[{"equation":"m=8/4","explanation":"Compute changes."},{"equation":"m=2","explanation":"Reduce."}]},
    {"id":"A3A-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"What is the slope of y=-4x+7?","answer_key":"-4","accepted_answers":["-4"],"diagnostic_tag":"equation","tutor_behavior":"In y=mx+b, m is slope.","hint_steps":["Identify coefficient of x.","The coefficient is -4.","m=-4."],"solution_steps":[{"equation":"y=mx+b","explanation":"Slope-intercept form."},{"equation":"m=-4","explanation":"Read the x coefficient."}]},
    {"id":"A3A-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Find the slope through (2,7) and (6,3).","answer_key":"-1","accepted_answers":["-1","-1/1"],"diagnostic_tag":"sign","tutor_behavior":"Falling as x increases gives negative slope.","hint_steps":["Rise=3-7=-4.","Run=6-2=4.","m=-4/4=-1."],"solution_steps":[{"equation":"m=-4/4","explanation":"Compute rise/run."},{"equation":"m=-1","explanation":"Reduce."}]},
    {"id":"A3A-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"A table has x-values 1,4,7 and y-values 2,11,20. Find the slope.","answer_key":"3","accepted_answers":["3"],"diagnostic_tag":"rise_run","tutor_behavior":"Use equal changes from any two rows.","hint_steps":["Δy=9.","Δx=3.","m=3."],"solution_steps":[{"equation":"m=(11-2)/(4-1)=9/3","explanation":"Use two rows."},{"equation":"m=3","explanation":"Simplify."}]},
    {"id":"A3A-P03","type":"independent_practice","difficulty":"Challenging","prompt":"What is the slope of 2x+y=9?","answer_key":"-2","accepted_answers":["-2"],"diagnostic_tag":"equation","tutor_behavior":"Rewrite the equation as y=mx+b.","hint_steps":["Subtract 2x: y=-2x+9.","The coefficient of x is -2.","m=-2."],"solution_steps":[{"equation":"y=-2x+9","explanation":"Solve for y."},{"equation":"m=-2","explanation":"Read slope."}]},
    {"id":"A3A-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Find the slope through (1,4) and (3,10).","answer_key":"3","accepted_answers":["3"],"diagnostic_tag":"points","tutor_behavior":"Use rise/run.","hint_steps":["Rise=6.","Run=2.","m=3."],"solution_steps":[{"equation":"m=6/2=3","explanation":"Compute slope."}]},
    {"id":"A3A-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Find the slope through (-4,1) and (0,-7).","answer_key":"-2","accepted_answers":["-2"],"diagnostic_tag":"sign","tutor_behavior":"Compute y-change over x-change.","hint_steps":["Rise=-8.","Run=4.","m=-2."],"solution_steps":[{"equation":"m=-8/4=-2","explanation":"Slope."}]},
    {"id":"A3A-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"A table has x-values 0,5,10 and y-values 4,14,24. Find the slope.","answer_key":"2","accepted_answers":["2"],"diagnostic_tag":"rise_run","tutor_behavior":"Use change in y/change in x.","hint_steps":["Δy=10.","Δx=5.","m=2."],"solution_steps":[{"equation":"m=10/5=2","explanation":"Slope."}]},
    {"id":"A3A-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"What is the slope of y=(1/2)x-6?","answer_key":"1/2","accepted_answers":["1/2","0.5"],"diagnostic_tag":"equation","tutor_behavior":"The x coefficient is the slope.","hint_steps":["The equation is already y=mx+b.","m=1/2.","Slope=1/2."],"solution_steps":[{"equation":"m=1/2","explanation":"Read the coefficient."}]},
    {"id":"A3A-M05","type":"mastery_check","difficulty":"Grade-level","prompt":"What is the slope of 3x-2y=12?","answer_key":"3/2","accepted_answers":["3/2","1.5"],"diagnostic_tag":"equation","tutor_behavior":"Solve for y.","hint_steps":["-2y=-3x+12.","y=(3/2)x-6.","m=3/2."],"solution_steps":[{"equation":"y=(3/2)x-6","explanation":"Rewrite."},{"equation":"m=3/2","explanation":"Read slope."}]}
  ]
}