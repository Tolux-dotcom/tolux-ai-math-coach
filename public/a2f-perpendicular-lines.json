{
  "module_id":"alg1-a2f-perpendicular-lines","version":"1.0.0-private-qa","course":"Algebra 1","teks":["A.2F"],"title":"Equations of Perpendicular Lines",
  "student_objective":"I can write the equation of a line through a point and perpendicular to a given line.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A2F-D01","A2F-D02"],"guided_item_ids":["A2F-G01","A2F-G02","A2F-G03"],"independent_item_ids":["A2F-P01","A2F-P02","A2F-P03"],"mastery_item_ids":["A2F-M01","A2F-M02","A2F-M03","A2F-M04","A2F-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Perpendicular slope readiness"},{"step":2,"type":"concept","label":"Use negative reciprocal slopes"},{"step":3,"type":"worked_examples","label":"Watch Tolux build perpendicular lines"},{"step":4,"type":"guided_practice","label":"Write perpendicular lines with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A2F-C01","title":"Negative reciprocal","content":"For nonvertical, nonhorizontal lines, perpendicular slopes are negative reciprocals: flip the fraction and change the sign."},
    {"id":"A2F-C02","title":"Product check","content":"If two finite slopes are perpendicular, their product is -1."},
    {"id":"A2F-C03","title":"Use the required point","content":"After finding the perpendicular slope, substitute the required point into y=mx+b and solve for b."},
    {"id":"A2F-C04","title":"Special case","content":"Horizontal and vertical lines are perpendicular to each other; their slopes are 0 and undefined."}
  ],
  "misconception_routes":{
    "negative_reciprocal":{"route":"slope","error_code":"PERP-SLOPE","teacher_signal":"Student changes only the sign or only flips the slope."},
    "new_intercept":{"route":"intercept","error_code":"PERP-B","teacher_signal":"Student finds the correct perpendicular slope but not the line through the required point."},
    "rewrite_equation":{"route":"form","error_code":"PERP-FORM","teacher_signal":"Student misreads the original slope from standard form."}
  },
  "items":[
    {"id":"A2F-D01","type":"diagnostic","difficulty":"Foundational","prompt":"What slope is perpendicular to 3?","answer_key":"-1/3","accepted_answers":["-1/3","m=-1/3"],"diagnostic_tag":"negative_reciprocal","tutor_behavior":"Write 3 as 3/1, then flip and change sign.","hint_steps":["3=3/1.","Flip to 1/3 and change the sign.","The perpendicular slope is -1/3."],"solution_steps":[{"equation":"3=3/1","explanation":"Write slope as a fraction."},{"equation":"m_perp=-1/3","explanation":"Take the negative reciprocal."}]},
    {"id":"A2F-D02","type":"diagnostic","difficulty":"Foundational","prompt":"What slope is perpendicular to -2/5?","answer_key":"5/2","accepted_answers":["5/2","2.5","m=5/2"],"diagnostic_tag":"negative_reciprocal","tutor_behavior":"Flip the fraction and reverse the sign.","hint_steps":["Flip -2/5 to -5/2.","Change the sign to positive.","The perpendicular slope is 5/2."],"solution_steps":[{"equation":"m=-2/5","explanation":"Start with the given slope."},{"equation":"m_perp=5/2","explanation":"Use the negative reciprocal."}]},
    {"id":"A2F-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Write the line through (3,4) perpendicular to y=2x+1.","answer_key":"y=(-1/2)x+5.5","accepted_answers":["y=(-1/2)x+5.5","y=-0.5x+5.5","x+2y=11"],"diagnostic_tag":"new_intercept","tutor_behavior":"Use perpendicular slope -1/2, then the point.","hint_steps":["The negative reciprocal of 2 is -1/2.","4=(-1/2)(3)+b.","b=5.5, so y=(-1/2)x+5.5."],"solution_steps":[{"equation":"m_perp=-1/2","explanation":"Find the negative reciprocal."},{"equation":"4=-3/2+b → b=11/2","explanation":"Use the required point."},{"equation":"y=(-1/2)x+5.5","explanation":"Write the perpendicular line."}]},
    {"id":"A2F-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Write the line through (2,-1) perpendicular to y=(-3/4)x+6.","answer_key":"y=(4/3)x-11/3","accepted_answers":["y=(4/3)x-11/3","4x-3y=11"],"diagnostic_tag":"new_intercept","tutor_behavior":"The perpendicular slope to -3/4 is 4/3.","hint_steps":["Flip -3/4 and change sign to get 4/3.","-1=(4/3)(2)+b.","b=-11/3, so y=(4/3)x-11/3."],"solution_steps":[{"equation":"m_perp=4/3","explanation":"Find the negative reciprocal."},{"equation":"-1=8/3+b → b=-11/3","explanation":"Use the point."},{"equation":"y=(4/3)x-11/3","explanation":"Write the line."}]},
    {"id":"A2F-L03","type":"worked_example","difficulty":"Grade-level","prompt":"Write the line through (1,5) perpendicular to 2x+y=7.","answer_key":"y=(1/2)x+4.5","accepted_answers":["y=(1/2)x+4.5","y=0.5x+4.5","x-2y=-9"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Rewrite the given equation before taking a negative reciprocal.","hint_steps":["2x+y=7 gives y=-2x+7.","The perpendicular slope is 1/2.","5=1/2+b gives b=4.5, so y=(1/2)x+4.5."],"solution_steps":[{"equation":"y=-2x+7","explanation":"Find original slope -2."},{"equation":"m_perp=1/2","explanation":"Take negative reciprocal."},{"equation":"5=1/2+b → b=9/2","explanation":"Use the point."},{"equation":"y=(1/2)x+4.5","explanation":"Write the line."}]},
    {"id":"A2F-G01","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the line through (0,3) perpendicular to y=4x-2.","answer_key":"y=(-1/4)x+3","accepted_answers":["y=(-1/4)x+3","y=-0.25x+3","x+4y=12"],"diagnostic_tag":"negative_reciprocal","tutor_behavior":"Use -1/4 and the point x=0.","hint_steps":["Perpendicular slope is -1/4.","The point (0,3) gives b=3.","y=(-1/4)x+3."],"solution_steps":[{"equation":"m_perp=-1/4","explanation":"Find perpendicular slope."},{"equation":"b=3","explanation":"Use the y-axis point."},{"equation":"y=(-1/4)x+3","explanation":"Write equation."}]},
    {"id":"A2F-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the line through (-3,2) perpendicular to y=(-1/2)x+8.","answer_key":"y=2x+8","accepted_answers":["y=2x+8","2x-y=-8"],"diagnostic_tag":"new_intercept","tutor_behavior":"Negative reciprocal of -1/2 is 2.","hint_steps":["m_perp=2.","2=2(-3)+b, so b=8.","y=2x+8."],"solution_steps":[{"equation":"m_perp=2","explanation":"Find slope."},{"equation":"2=-6+b → b=8","explanation":"Use point."},{"equation":"y=2x+8","explanation":"Write line."}]},
    {"id":"A2F-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the line through (4,0) perpendicular to 3x-6y=12.","answer_key":"y=-2x+8","accepted_answers":["y=-2x+8","2x+y=8"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Rewrite to find original slope 1/2.","hint_steps":["3x-6y=12 gives y=(1/2)x-2.","Perpendicular slope is -2.","0=-2(4)+b gives b=8, so y=-2x+8."],"solution_steps":[{"equation":"y=(1/2)x-2","explanation":"Find original slope."},{"equation":"m_perp=-2","explanation":"Take negative reciprocal."},{"equation":"b=8","explanation":"Use point."},{"equation":"y=-2x+8","explanation":"Write line."}]},
    {"id":"A2F-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the line through (5,1) perpendicular to y=(1/3)x-7.","answer_key":"y=-3x+16","accepted_answers":["y=-3x+16","3x+y=16"],"diagnostic_tag":"negative_reciprocal","tutor_behavior":"Perpendicular slope to 1/3 is -3.","hint_steps":["m_perp=-3.","1=-15+b gives b=16.","y=-3x+16."],"solution_steps":[{"equation":"m_perp=-3","explanation":"Find slope."},{"equation":"b=16","explanation":"Use point."},{"equation":"y=-3x+16","explanation":"Write line."}]},
    {"id":"A2F-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the line through (-2,-4) perpendicular to y=-5x+1.","answer_key":"y=(1/5)x-18/5","accepted_answers":["y=(1/5)x-18/5","y=0.2x-3.6","x-5y=18"],"diagnostic_tag":"new_intercept","tutor_behavior":"Negative reciprocal of -5 is 1/5.","hint_steps":["m_perp=1/5.","-4=(1/5)(-2)+b.","b=-18/5, so y=(1/5)x-18/5."],"solution_steps":[{"equation":"m_perp=1/5","explanation":"Find perpendicular slope."},{"equation":"-4=-2/5+b → b=-18/5","explanation":"Use point."},{"equation":"y=(1/5)x-18/5","explanation":"Write line."}]},
    {"id":"A2F-P03","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the line through (6,2) perpendicular to x+2y=10.","answer_key":"y=2x-10","accepted_answers":["y=2x-10","2x-y=10"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Rewrite x+2y=10 to find slope -1/2.","hint_steps":["x+2y=10 gives y=(-1/2)x+5.","Perpendicular slope is 2.","2=12+b gives b=-10, so y=2x-10."],"solution_steps":[{"equation":"y=(-1/2)x+5","explanation":"Find original slope."},{"equation":"m_perp=2","explanation":"Take negative reciprocal."},{"equation":"y=2x-10","explanation":"Use point and write line."}]},
    {"id":"A2F-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (2,3) perpendicular to y=3x+4.","answer_key":"y=(-1/3)x+11/3","accepted_answers":["y=(-1/3)x+11/3","x+3y=11"],"diagnostic_tag":"negative_reciprocal","tutor_behavior":"Use slope -1/3.","hint_steps":["m_perp=-1/3.","3=-2/3+b gives b=11/3.","y=(-1/3)x+11/3."],"solution_steps":[{"equation":"m_perp=-1/3","explanation":"Find slope."},{"equation":"b=11/3","explanation":"Use point."},{"equation":"y=(-1/3)x+11/3","explanation":"Write line."}]},
    {"id":"A2F-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (1,-2) perpendicular to y=(-2/3)x+5.","answer_key":"y=(3/2)x-7/2","accepted_answers":["y=(3/2)x-7/2","3x-2y=7"],"diagnostic_tag":"new_intercept","tutor_behavior":"Use perpendicular slope 3/2.","hint_steps":["m_perp=3/2.","-2=3/2+b gives b=-7/2.","y=(3/2)x-7/2."],"solution_steps":[{"equation":"m_perp=3/2","explanation":"Find slope."},{"equation":"b=-7/2","explanation":"Use point."},{"equation":"y=(3/2)x-7/2","explanation":"Write line."}]},
    {"id":"A2F-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (0,6) perpendicular to 4x-2y=8.","answer_key":"y=(-1/2)x+6","accepted_answers":["y=(-1/2)x+6","y=-0.5x+6","x+2y=12"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Original slope is 2, so perpendicular slope is -1/2.","hint_steps":["4x-2y=8 gives y=2x-4.","m_perp=-1/2.","b=6, so y=(-1/2)x+6."],"solution_steps":[{"equation":"y=2x-4","explanation":"Find original slope."},{"equation":"m_perp=-1/2","explanation":"Take negative reciprocal."},{"equation":"y=(-1/2)x+6","explanation":"Use point x=0."}]},
    {"id":"A2F-M04","type":"mastery_check","difficulty":"Challenging","prompt":"A line perpendicular to y=(5/2)x-1 passes through (10,7). Write its equation.","answer_key":"y=(-2/5)x+11","accepted_answers":["y=(-2/5)x+11","2x+5y=55"],"diagnostic_tag":"negative_reciprocal","tutor_behavior":"Negative reciprocal of 5/2 is -2/5.","hint_steps":["m_perp=-2/5.","7=(-2/5)(10)+b=-4+b.","b=11, so y=(-2/5)x+11."],"solution_steps":[{"equation":"m_perp=-2/5","explanation":"Find slope."},{"equation":"7=-4+b → b=11","explanation":"Use point."},{"equation":"y=(-2/5)x+11","explanation":"Write line."}]},
    {"id":"A2F-M05","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (-1,4) perpendicular to 2x+4y=9.","answer_key":"y=2x+6","accepted_answers":["y=2x+6","2x-y=-6"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Original slope is -1/2.","hint_steps":["2x+4y=9 gives y=(-1/2)x+9/4.","Perpendicular slope is 2.","4=2(-1)+b gives b=6, so y=2x+6."],"solution_steps":[{"equation":"m=-1/2","explanation":"Read original slope after rewriting."},{"equation":"m_perp=2","explanation":"Take negative reciprocal."},{"equation":"y=2x+6","explanation":"Use the point."}]}
  ]
}