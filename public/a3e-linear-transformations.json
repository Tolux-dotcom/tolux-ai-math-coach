  "course":"Algebra 1",
  "teks":["A.3E"],
  "title":"Transform the Linear Parent Function",
  "student_objective":"I can describe and graph how changes to parameters transform the parent function f(x)=x.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A3E-D01","A3E-D02"],"guided_item_ids":["A3E-G01","A3E-G02","A3E-G03"],"independent_item_ids":["A3E-P01","A3E-P02","A3E-P03"],"mastery_item_ids":["A3E-M01","A3E-M02","A3E-M03","A3E-M04","A3E-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Parent function readiness"},{"step":2,"type":"concept","label":"See the graph move and tilt"},{"step":3,"type":"worked_examples","label":"Watch Tolux compare transformations"},{"step":4,"type":"guided_practice","label":"Transform with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A3E-C01","title":"Parent function","content":"The linear parent function is f(x)=x. It has slope 1 and y-intercept 0."},
    {"id":"A3E-C02","title":"Change the slope","content":"In y=mx+b, changing m changes the steepness and direction. Larger |m| is steeper; negative m makes the line decrease."},
    {"id":"A3E-C03","title":"Vertical shift","content":"Changing b moves the entire line up or down without changing the slope."},
    {"id":"A3E-C04","title":"Compare before and after","content":"Use the parent line y=x as a visual reference. Ask: Did the line get steeper, flip direction, or shift vertically?"}
  ],
  "misconception_routes":{"slope_effect":{"route":"slope","error_code":"TRANS-SLOPE","teacher_signal":"Student confuses steepness with vertical shift."},"sign_effect":{"route":"direction","error_code":"TRANS-SIGN","teacher_signal":"Student misses reflection/decreasing behavior from negative slope."},"vertical_shift":{"route":"intercept","error_code":"TRANS-SHIFT","teacher_signal":"Student changes slope when only b changes."}},
  "items":[
    {"id":"A3E-D01","type":"diagnostic","difficulty":"Foundational","prompt":"For the parent function y=x, what is the slope?","answer_key":"1","accepted_answers":["1","one"],"diagnostic_tag":"slope_effect","tutor_behavior":"Anchor transformation work to the parent slope.","hint_steps":["Use y=mx+b.","In y=x, the coefficient of x is 1.","The slope is 1."],"solution_steps":[{"equation":"y=1x+0","explanation":"Write the parent function in slope-intercept form."},{"equation":"m=1","explanation":"The x-coefficient is the slope."}]},
    {"id":"A3E-D02","type":"diagnostic","difficulty":"Foundational","prompt":"Compared with y=x, does y=x+4 shift up or down?","answer_key":"up 4","accepted_answers":["up 4","up","4 units up"],"diagnostic_tag":"vertical_shift","tutor_behavior":"Connect +b with upward translation.","hint_steps":["The slope is still 1.","Only the y-intercept changed from 0 to 4.","The line shifts up 4 units."],"solution_steps":[{"equation":"y=x+4","explanation":"The slope remains 1."},{"equation":"b: 0→4","explanation":"The line shifts up 4."}]},
    {"id":"A3E-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Describe how y=3x compares with y=x.","answer_key":"steeper; same intercept","accepted_answers":["steeper; same intercept","steeper through origin","slope increases from 1 to 3"],"diagnostic_tag":"slope_effect","tutor_behavior":"Show the parent and transformed line on the same axes.","hint_steps":["Compare slopes 1 and 3.","Both have b=0.","y=3x is steeper and still passes through the origin."],"solution_steps":[{"equation":"m: 1→3","explanation":"The magnitude of slope increases."},{"equation":"b=0","explanation":"The y-intercept stays at the origin."}]},
    {"id":"A3E-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Describe how y=-x compares with y=x.","answer_key":"changes from increasing to decreasing; same intercept","accepted_answers":["changes from increasing to decreasing; same intercept","decreasing through origin","reflected direction same intercept"],"diagnostic_tag":"sign_effect","tutor_behavior":"Visualize the line tilting from positive to negative slope.","hint_steps":["The slope changes from 1 to -1.","A negative slope decreases left to right.","The intercept remains 0."],"solution_steps":[{"equation":"m: 1→-1","explanation":"The slope changes sign."},{"equation":"b=0","explanation":"The line still passes through the origin."}]},
    {"id":"A3E-G01","type":"guided_practice","difficulty":"Grade-level","prompt":"Describe y=0.5x compared with y=x.","answer_key":"less steep; same intercept","accepted_answers":["less steep; same intercept","less steep through origin","flatter same intercept"],"diagnostic_tag":"slope_effect","tutor_behavior":"Compare slope magnitudes visually.","hint_steps":["Compare |0.5| with |1|.","0.5 has smaller magnitude.","The line is less steep and still passes through the origin."],"solution_steps":[{"equation":"|0.5|<|1|","explanation":"Smaller slope magnitude makes a flatter line."},{"equation":"b=0","explanation":"Same y-intercept."}]},
    {"id":"A3E-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Describe y=x-6 compared with y=x.","answer_key":"down 6; same slope","accepted_answers":["down 6; same slope","6 units down","shift down 6"],"diagnostic_tag":"vertical_shift","tutor_behavior":"Separate vertical shift from slope change.","hint_steps":["The x-coefficient remains 1.","The intercept changes from 0 to -6.","Shift the line down 6 units."],"solution_steps":[{"equation":"m=1","explanation":"Slope does not change."},{"equation":"b: 0→-6","explanation":"Translate down 6 units."}]},
    {"id":"A3E-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Describe y=-2x+3 compared with y=x.","answer_key":"decreasing and steeper; shifted up 3","accepted_answers":["decreasing and steeper; shifted up 3","negative steeper up 3","slope -2 and y-intercept 3"],"diagnostic_tag":"sign_effect","tutor_behavior":"Combine slope and intercept changes.","hint_steps":["Compare slope 1 to -2.","Negative means decreasing; |2|>1 means steeper.","b=3 shifts the line up 3."],"solution_steps":[{"equation":"m: 1→-2","explanation":"Direction flips and steepness increases."},{"equation":"b: 0→3","explanation":"The line shifts up 3."}]},
    {"id":"A3E-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Describe y=4x-2 compared with y=x.","answer_key":"steeper; shifted down 2","accepted_answers":["steeper; shifted down 2","steeper down 2","slope 4 intercept -2"],"diagnostic_tag":"slope_effect","tutor_behavior":"Student analyzes both parameters independently.","hint_steps":["Compare slopes 1 and 4.","4 is steeper.","b=-2 shifts down 2."],"solution_steps":[{"equation":"m=4","explanation":"The line is steeper than y=x."},{"equation":"b=-2","explanation":"The graph moves down 2."}]},
    {"id":"A3E-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Describe y=-0.25x+5 compared with y=x.","answer_key":"decreasing and less steep; shifted up 5","accepted_answers":["decreasing and less steep; shifted up 5","negative flatter up 5","slope -0.25 intercept 5"],"diagnostic_tag":"sign_effect","tutor_behavior":"Analyze sign, magnitude, and intercept.","hint_steps":["Negative slope means decreasing.","|0.25|<1 means less steep.","b=5 shifts up 5."],"solution_steps":[{"equation":"m=-0.25","explanation":"Negative and flatter than the parent line."},{"equation":"b=5","explanation":"Shift up 5."}]},
    {"id":"A3E-P03","type":"independent_practice","difficulty":"Grade-level","prompt":"Which parameter changes when y=x becomes y=x+9: slope or y-intercept?","answer_key":"y-intercept","accepted_answers":["y-intercept","intercept","b"],"diagnostic_tag":"vertical_shift","tutor_behavior":"Reinforce parameter meaning.","hint_steps":["The coefficient of x is unchanged.","Only +9 was added.","The y-intercept changes."],"solution_steps":[{"equation":"m=1 in both","explanation":"Slope stays the same."},{"equation":"b: 0→9","explanation":"The y-intercept changes."}]},
    {"id":"A3E-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Compared with y=x, describe y=2x.","answer_key":"steeper; same intercept","accepted_answers":["steeper; same intercept","steeper through origin"],"diagnostic_tag":"slope_effect","tutor_behavior":"Mastery check on slope magnitude.","hint_steps":["Compare slopes 1 and 2.","2 is larger in magnitude.","The line is steeper and still has b=0."],"solution_steps":[{"equation":"m:1→2","explanation":"Steepness increases."},{"equation":"b=0","explanation":"Same intercept."}]},
    {"id":"A3E-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Compared with y=x, describe y=x-3.","answer_key":"down 3; same slope","accepted_answers":["down 3; same slope","shift down 3"],"diagnostic_tag":"vertical_shift","tutor_behavior":"Mastery check on vertical translation.","hint_steps":["The slope is still 1.","b=-3.","Shift down 3."],"solution_steps":[{"equation":"m=1","explanation":"Slope unchanged."},{"equation":"b=-3","explanation":"Shift down 3."}]},
    {"id":"A3E-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Compared with y=x, describe y=-3x+1.","answer_key":"decreasing and steeper; shifted up 1","accepted_answers":["decreasing and steeper; shifted up 1","negative steeper up 1"],"diagnostic_tag":"sign_effect","tutor_behavior":"Mastery check on combined changes.","hint_steps":["-3 is negative and has magnitude 3.","So the line decreases and is steeper.","+1 shifts up 1."],"solution_steps":[{"equation":"m=-3","explanation":"Direction changes and steepness increases."},{"equation":"b=1","explanation":"Shift up 1."}]},
    {"id":"A3E-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"Which line is steeper: y=0.4x or y=2x?","answer_key":"y=2x","accepted_answers":["y=2x","2x"],"diagnostic_tag":"slope_effect","tutor_behavior":"Compare absolute slope values.","hint_steps":["Steepness depends on |m|.","|2|>|0.4|.","y=2x is steeper."],"solution_steps":[{"equation":"|2|>|0.4|","explanation":"Larger slope magnitude is steeper."},{"equation":"y=2x","explanation":"This line is steeper."}]},
    {"id":"A3E-M05","type":"mastery_check","difficulty":"Grade-level","prompt":"What happens to y=x if the y-intercept changes from 0 to 7 while slope stays 1?","answer_key":"shift up 7","accepted_answers":["shift up 7","up 7","7 units up"],"diagnostic_tag":"vertical_shift","tutor_behavior":"Interpret intercept change visually.","hint_steps":["Slope staying 1 keeps the same tilt.","The intercept moves from 0 to 7.","The whole line shifts up 7."],"solution_steps":[{"equation":"b:0→7","explanation":"Only the vertical position changes."},{"equation":"shift up 7","explanation":"The line translates upward."}]}
  ]
}