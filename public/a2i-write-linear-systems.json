{
  "module_id":"alg1-a2i-write-linear-systems",
  "version":"1.0.0-private-qa",
  "course":"Algebra 1",
  "teks":["A.2I"],
  "title":"Write Systems of Linear Equations",
  "student_objective":"I can write systems of two linear equations from graphs, tables, and descriptions and connect the intersection to the shared solution.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A2I-D01","A2I-D02"],"guided_item_ids":["A2I-G01","A2I-G02","A2I-G03"],"independent_item_ids":["A2I-P01","A2I-P02","A2I-P03"],"mastery_item_ids":["A2I-M01","A2I-M02","A2I-M03","A2I-M04","A2I-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"System readiness"},{"step":2,"type":"concept","label":"Build two equations from one situation"},{"step":3,"type":"worked_examples","label":"Watch Tolux write and read systems"},{"step":4,"type":"guided_practice","label":"Write systems with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A2I-C01","title":"A system is two equations together","content":"A system models two relationships using the same variables. Each equation describes one line."},
    {"id":"A2I-C02","title":"From a graph","content":"Read the slope and intercept of each line separately, then write the two equations as one system."},
    {"id":"A2I-C03","title":"From a table or description","content":"Find the rate of change and starting value for each relationship. Keep the same variable meanings in both equations."},
    {"id":"A2I-C04","title":"Intersection gives the shared solution","content":"The point where the two graphs intersect satisfies both equations. In context, that point is where the two situations are equal."}
  ],
  "misconception_routes":{
    "first_line":{"route":"line1","error_code":"SYS-WRITE-1","teacher_signal":"Student writes one relationship incorrectly."},
    "second_line":{"route":"line2","error_code":"SYS-WRITE-2","teacher_signal":"Student omits or miswrites the second relationship."},
    "context":{"route":"context","error_code":"SYS-WRITE-CONTEXT","teacher_signal":"Student changes variable meaning between equations."},
    "intersection":{"route":"intersection","error_code":"SYS-INTERSECTION","teacher_signal":"Student does not connect the crossing point to both equations."}
  },
  "items":[
    {"id":"A2I-D01","type":"diagnostic","difficulty":"Foundational","prompt":"A line has slope 2 and y-intercept 1. Write its equation.","answer_key":"y=2x+1","accepted_answers":["y=2x+1","y = 2x + 1"],"diagnostic_tag":"first_line","tutor_behavior":"Use y=mx+b.","hint_steps":["m=2.","b=1.","y=2x+1."],"solution_steps":[{"equation":"y=mx+b","explanation":"Use slope-intercept form."},{"equation":"y=2x+1","explanation":"Substitute m and b."}]},
    {"id":"A2I-D02","type":"diagnostic","difficulty":"Foundational","prompt":"A line has slope -1 and y-intercept 4. Write its equation.","answer_key":"y=-x+4","accepted_answers":["y=-x+4","y = -x + 4"],"diagnostic_tag":"second_line","tutor_behavior":"Use y=mx+b.","hint_steps":["m=-1.","b=4.","y=-x+4."],"solution_steps":[{"equation":"y=-x+4","explanation":"Write the line in slope-intercept form."}]},
    {"id":"A2I-L01","type":"worked_example","difficulty":"Grade-level","prompt":"A graph shows one line y=2x+1 and another line y=-x+4. Write the system using a semicolon between equations.","answer_key":"y=2x+1;y=-x+4","accepted_answers":["y=2x+1;y=-x+4","y=-x+4;y=2x+1"],"diagnostic_tag":"first_line","tutor_behavior":"Write both line equations together.","hint_steps":["Read the first line: y=2x+1.","Read the second line: y=-x+4.","System: y=2x+1; y=-x+4."],"solution_steps":[{"equation":"line 1: y=2x+1","explanation":"Record the first line."},{"equation":"line 2: y=-x+4","explanation":"Record the second line."},{"equation":"system: y=2x+1; y=-x+4","explanation":"Put them together."}]},
    {"id":"A2I-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Two plans cost A=5x+20 and B=8x+2, where x is the number of units. Write the system using y for cost and a semicolon.","answer_key":"y=5x+20;y=8x+2","accepted_answers":["y=5x+20;y=8x+2","y=8x+2;y=5x+20"],"diagnostic_tag":"context","tutor_behavior":"Use the same variables in both equations.","hint_steps":["Plan A gives y=5x+20.","Plan B gives y=8x+2.","Write both as one system."],"solution_steps":[{"equation":"y=5x+20","explanation":"First plan."},{"equation":"y=8x+2","explanation":"Second plan."},{"equation":"system: y=5x+20; y=8x+2","explanation":"Combine them."}]},
    {"id":"A2I-L03","type":"worked_example","difficulty":"Grade-level","prompt":"Line 1 passes through (0,3) and (2,7). Line 2 passes through (0,9) and (3,3). Write the system with a semicolon.","answer_key":"y=2x+3;y=-2x+9","accepted_answers":["y=2x+3;y=-2x+9","y=-2x+9;y=2x+3"],"diagnostic_tag":"first_line","tutor_behavior":"Find each slope from two points, then use the y-intercept.","hint_steps":["Line 1 slope=(7-3)/(2-0)=2 and b=3.","Line 2 slope=(3-9)/(3-0)=-2 and b=9.","System: y=2x+3; y=-2x+9."],"solution_steps":[{"equation":"m₁=2, b₁=3","explanation":"Find line 1."},{"equation":"m₂=-2, b₂=9","explanation":"Find line 2."},{"equation":"y=2x+3; y=-2x+9","explanation":"Write the system."}]},
    {"id":"A2I-G01","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the system for y=3x-1 and y=-x+7 using a semicolon.","answer_key":"y=3x-1;y=-x+7","accepted_answers":["y=3x-1;y=-x+7","y=-x+7;y=3x-1"],"diagnostic_tag":"second_line","tutor_behavior":"A system contains both equations.","hint_steps":["Copy the first relationship exactly.","Copy the second relationship exactly.","y=3x-1; y=-x+7."],"solution_steps":[{"equation":"y=3x-1; y=-x+7","explanation":"Write both equations."}]},
    {"id":"A2I-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Two services charge y=4x+12 and y=6x+2. Write the system using a semicolon.","answer_key":"y=4x+12;y=6x+2","accepted_answers":["y=4x+12;y=6x+2","y=6x+2;y=4x+12"],"diagnostic_tag":"context","tutor_behavior":"Keep x and y consistent across both services.","hint_steps":["First service: y=4x+12.","Second service: y=6x+2.","Write them together."],"solution_steps":[{"equation":"y=4x+12; y=6x+2","explanation":"System."}]},
    {"id":"A2I-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"A graph has lines y=x+1 and y=-2x+7. What point is their intersection? Answer as (x,y).","answer_key":"(2,3)","accepted_answers":["(2,3)","2,3"],"diagnostic_tag":"intersection","tutor_behavior":"At the intersection both equations have the same y-value.","hint_steps":["Set x+1=-2x+7.","3x=6, so x=2.","Then y=3, so (2,3)."],"solution_steps":[{"equation":"x+1=-2x+7","explanation":"Set equations equal."},{"equation":"3x=6 → x=2","explanation":"Solve for x."},{"equation":"y=3","explanation":"Substitute back."},{"equation":"(2,3)","explanation":"Shared solution."}]},
    {"id":"A2I-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the system for y=2x-5 and y=5x+1 using a semicolon.","answer_key":"y=2x-5;y=5x+1","accepted_answers":["y=2x-5;y=5x+1","y=5x+1;y=2x-5"],"diagnostic_tag":"first_line","tutor_behavior":"Include both equations.","hint_steps":["First line y=2x-5.","Second line y=5x+1.","Write both with a semicolon."],"solution_steps":[{"equation":"y=2x-5; y=5x+1","explanation":"System."}]},
    {"id":"A2I-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Taxi A costs y=2x+6. Taxi B costs y=3x+1. Write the system.","answer_key":"y=2x+6;y=3x+1","accepted_answers":["y=2x+6;y=3x+1","y=3x+1;y=2x+6"],"diagnostic_tag":"context","tutor_behavior":"Each taxi is one equation using the same x and y.","hint_steps":["Write Taxi A.","Write Taxi B.","Combine the equations."],"solution_steps":[{"equation":"y=2x+6; y=3x+1","explanation":"System."}]},
    {"id":"A2I-P03","type":"independent_practice","difficulty":"Challenging","prompt":"Line 1 passes through (0,-2) and (4,6). Line 2 passes through (0,6) and (2,2). Write the system.","answer_key":"y=2x-2;y=-2x+6","accepted_answers":["y=2x-2;y=-2x+6","y=-2x+6;y=2x-2"],"diagnostic_tag":"first_line","tutor_behavior":"Compute each slope and use the y-intercept.","hint_steps":["Line 1 slope 2, intercept -2.","Line 2 slope -2, intercept 6.","System y=2x-2; y=-2x+6."],"solution_steps":[{"equation":"m₁=2, b₁=-2","explanation":"Line 1."},{"equation":"m₂=-2, b₂=6","explanation":"Line 2."},{"equation":"y=2x-2; y=-2x+6","explanation":"System."}]},
    {"id":"A2I-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the system y=x+4 and y=-x+10 using a semicolon.","answer_key":"y=x+4;y=-x+10","accepted_answers":["y=x+4;y=-x+10","y=-x+10;y=x+4"],"diagnostic_tag":"second_line","tutor_behavior":"Write both equations.","hint_steps":["First y=x+4.","Second y=-x+10.","Combine them."],"solution_steps":[{"equation":"y=x+4; y=-x+10","explanation":"System."}]},
    {"id":"A2I-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Plan A is y=7x+5 and Plan B is y=4x+20. Write the system.","answer_key":"y=7x+5;y=4x+20","accepted_answers":["y=7x+5;y=4x+20","y=4x+20;y=7x+5"],"diagnostic_tag":"context","tutor_behavior":"Use the same x and y.","hint_steps":["Record Plan A.","Record Plan B.","Combine them."],"solution_steps":[{"equation":"y=7x+5; y=4x+20","explanation":"System."}]},
    {"id":"A2I-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Find the intersection of y=2x and y=-x+9. Answer as (x,y).","answer_key":"(3,6)","accepted_answers":["(3,6)","3,6"],"diagnostic_tag":"intersection","tutor_behavior":"Set the equations equal.","hint_steps":["2x=-x+9.","3x=9 so x=3.","y=6, giving (3,6)."],"solution_steps":[{"equation":"2x=-x+9","explanation":"Equal y-values."},{"equation":"x=3","explanation":"Solve."},{"equation":"y=6","explanation":"Substitute."},{"equation":"(3,6)","explanation":"Intersection."}]},
    {"id":"A2I-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"Line 1 has slope 3 and y-intercept -2. Line 2 has slope -1 and y-intercept 6. Write the system.","answer_key":"y=3x-2;y=-x+6","accepted_answers":["y=3x-2;y=-x+6","y=-x+6;y=3x-2"],"diagnostic_tag":"first_line","tutor_behavior":"Use y=mx+b for each line.","hint_steps":["Line 1 y=3x-2.","Line 2 y=-x+6.","Combine them."],"solution_steps":[{"equation":"y=3x-2; y=-x+6","explanation":"System."}]},
    {"id":"A2I-M05","type":"mastery_check","difficulty":"Grade-level","prompt":"A graph has lines y=4x-3 and y=x+6. Write the system.","answer_key":"y=4x-3;y=x+6","accepted_answers":["y=4x-3;y=x+6","y=x+6;y=4x-3"],"diagnostic_tag":"second_line","tutor_behavior":"A system needs both graphed equations.","hint_steps":["Read line 1.","Read line 2.","Write both equations."],"solution_steps":[{"equation":"y=4x-3; y=x+6","explanation":"System."}]}
  ]
}