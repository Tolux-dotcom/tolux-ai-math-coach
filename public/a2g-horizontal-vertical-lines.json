{
  "module_id":"alg1-a2g-horizontal-vertical-lines","version":"1.0.0-private-qa","course":"Algebra 1","teks":["A.2G"],"title":"Horizontal and Vertical Lines",
  "student_objective":"I can write equations of horizontal and vertical lines and classify zero and undefined slope.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A2G-D01","A2G-D02"],"guided_item_ids":["A2G-G01","A2G-G02","A2G-G03"],"independent_item_ids":["A2G-P01","A2G-P02","A2G-P03"],"mastery_item_ids":["A2G-M01","A2G-M02","A2G-M03","A2G-M04","A2G-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Axis-line readiness"},{"step":2,"type":"concept","label":"Horizontal y=c and vertical x=c"},{"step":3,"type":"worked_examples","label":"Watch Tolux classify axis lines"},{"step":4,"type":"guided_practice","label":"Write axis lines with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A2G-C01","title":"Horizontal lines","content":"A horizontal line has equation y=c. Its y-value stays constant while x can vary, so its slope is 0."},
    {"id":"A2G-C02","title":"Vertical lines","content":"A vertical line has equation x=c. Its x-value stays constant while y can vary, so its slope is undefined."},
    {"id":"A2G-C03","title":"Parallel to an axis","content":"A line parallel to the x-axis is horizontal. A line parallel to the y-axis is vertical."},
    {"id":"A2G-C04","title":"Perpendicular to an axis","content":"A line perpendicular to the x-axis is vertical. A line perpendicular to the y-axis is horizontal."}
  ],
  "misconception_routes":{
    "horizontal":{"route":"horizontal","error_code":"AXIS-H","teacher_signal":"Student confuses y=constant with x=constant."},
    "vertical":{"route":"vertical","error_code":"AXIS-V","teacher_signal":"Student assigns slope 0 to vertical lines."},
    "axis_relationship":{"route":"axes","error_code":"AXIS-REL","teacher_signal":"Student confuses parallel and perpendicular relationships to coordinate axes."}
  },
  "items":[
    {"id":"A2G-D01","type":"diagnostic","difficulty":"Foundational","prompt":"What is the slope of a horizontal line?","answer_key":"0","accepted_answers":["0","zero"],"diagnostic_tag":"horizontal","tutor_behavior":"Horizontal means no rise as x changes.","hint_steps":["Slope is rise/run.","A horizontal line has rise 0.","Its slope is 0."],"solution_steps":[{"equation":"m=0/run=0","explanation":"There is no vertical change."},{"equation":"m=0","explanation":"Horizontal slope is zero."}]},
    {"id":"A2G-D02","type":"diagnostic","difficulty":"Foundational","prompt":"What is the slope of a vertical line?","answer_key":"undefined","accepted_answers":["undefined","no slope"],"diagnostic_tag":"vertical","tutor_behavior":"A vertical line has run 0, so slope division would use zero in the denominator.","hint_steps":["Slope is rise/run.","A vertical line has run 0.","Division by 0 is undefined, so the slope is undefined."],"solution_steps":[{"equation":"m=rise/0","explanation":"The horizontal change is zero."},{"equation":"m=undefined","explanation":"Division by zero is undefined."}]},
    {"id":"A2G-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Write the equation of the horizontal line through (3,-4).","answer_key":"y=-4","accepted_answers":["y=-4","-4=y"],"diagnostic_tag":"horizontal","tutor_behavior":"A horizontal line keeps the point's y-coordinate.","hint_steps":["Horizontal lines use y=c.","The point has y=-4.","The equation is y=-4."],"solution_steps":[{"equation":"y=c","explanation":"Use horizontal-line form."},{"equation":"y=-4","explanation":"Use the point's y-coordinate."}]},
    {"id":"A2G-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Write the equation of the vertical line through (-2,5).","answer_key":"x=-2","accepted_answers":["x=-2","-2=x"],"diagnostic_tag":"vertical","tutor_behavior":"A vertical line keeps the point's x-coordinate.","hint_steps":["Vertical lines use x=c.","The point has x=-2.","The equation is x=-2."],"solution_steps":[{"equation":"x=c","explanation":"Use vertical-line form."},{"equation":"x=-2","explanation":"Use the point's x-coordinate."}]},
    {"id":"A2G-L03","type":"worked_example","difficulty":"Grade-level","prompt":"Write the equation of the line through (7,1) perpendicular to the x-axis.","answer_key":"x=7","accepted_answers":["x=7","7=x"],"diagnostic_tag":"axis_relationship","tutor_behavior":"Perpendicular to the x-axis means vertical.","hint_steps":["The x-axis is horizontal.","A line perpendicular to it is vertical.","A vertical line through x=7 is x=7."],"solution_steps":[{"equation":"perpendicular to x-axis → vertical","explanation":"Use the axis relationship."},{"equation":"x=7","explanation":"Use the point's x-coordinate."}]},
    {"id":"A2G-G01","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the equation of the horizontal line through (-5,6).","answer_key":"y=6","accepted_answers":["y=6","6=y"],"diagnostic_tag":"horizontal","tutor_behavior":"Keep y constant.","hint_steps":["Horizontal means y=c.","The y-coordinate is 6.","y=6."],"solution_steps":[{"equation":"y=6","explanation":"All points on the line have y-coordinate 6."}]},
    {"id":"A2G-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the equation of the vertical line through (4,-3).","answer_key":"x=4","accepted_answers":["x=4","4=x"],"diagnostic_tag":"vertical","tutor_behavior":"Keep x constant.","hint_steps":["Vertical means x=c.","The x-coordinate is 4.","x=4."],"solution_steps":[{"equation":"x=4","explanation":"All points on the line have x-coordinate 4."}]},
    {"id":"A2G-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the equation of the line through (2,9) parallel to the x-axis.","answer_key":"y=9","accepted_answers":["y=9","9=y"],"diagnostic_tag":"axis_relationship","tutor_behavior":"Parallel to the x-axis means horizontal.","hint_steps":["The x-axis is horizontal.","A parallel line is also horizontal.","Through y=9, the equation is y=9."],"solution_steps":[{"equation":"parallel to x-axis → horizontal","explanation":"Classify the line."},{"equation":"y=9","explanation":"Use the y-coordinate."}]},
    {"id":"A2G-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the equation of the line through (-8,3) parallel to the y-axis.","answer_key":"x=-8","accepted_answers":["x=-8","-8=x"],"diagnostic_tag":"axis_relationship","tutor_behavior":"Parallel to y-axis means vertical.","hint_steps":["The y-axis is vertical.","A parallel line is vertical.","Through x=-8, the equation is x=-8."],"solution_steps":[{"equation":"parallel to y-axis → vertical","explanation":"Classify line."},{"equation":"x=-8","explanation":"Use the x-coordinate."}]},
    {"id":"A2G-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"A line has equation y=12. State its slope.","answer_key":"0","accepted_answers":["0","zero"],"diagnostic_tag":"horizontal","tutor_behavior":"y=constant is horizontal.","hint_steps":["y=12 keeps y constant.","That makes the line horizontal.","Horizontal slope is 0."],"solution_steps":[{"equation":"y=12 → horizontal","explanation":"Recognize the form."},{"equation":"m=0","explanation":"Horizontal slope is zero."}]},
    {"id":"A2G-P03","type":"independent_practice","difficulty":"Grade-level","prompt":"A line has equation x=-1. State its slope.","answer_key":"undefined","accepted_answers":["undefined","no slope"],"diagnostic_tag":"vertical","tutor_behavior":"x=constant is vertical.","hint_steps":["x=-1 keeps x constant.","That makes the line vertical.","Vertical slope is undefined."],"solution_steps":[{"equation":"x=-1 → vertical","explanation":"Recognize the form."},{"equation":"m=undefined","explanation":"Vertical slope is undefined."}]},
    {"id":"A2G-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the equation of the horizontal line through (10,-7).","answer_key":"y=-7","accepted_answers":["y=-7","-7=y"],"diagnostic_tag":"horizontal","tutor_behavior":"Use y=constant.","hint_steps":["Horizontal lines use y=c.","The point's y-coordinate is -7.","y=-7."],"solution_steps":[{"equation":"y=-7","explanation":"Keep y fixed at -7."}]},
    {"id":"A2G-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the equation of the vertical line through (6,11).","answer_key":"x=6","accepted_answers":["x=6","6=x"],"diagnostic_tag":"vertical","tutor_behavior":"Use x=constant.","hint_steps":["Vertical lines use x=c.","The point's x-coordinate is 6.","x=6."],"solution_steps":[{"equation":"x=6","explanation":"Keep x fixed at 6."}]},
    {"id":"A2G-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the equation of the line through (-3,5) perpendicular to the y-axis.","answer_key":"y=5","accepted_answers":["y=5","5=y"],"diagnostic_tag":"axis_relationship","tutor_behavior":"Perpendicular to the y-axis means horizontal.","hint_steps":["The y-axis is vertical.","A perpendicular line is horizontal.","Through y=5, the equation is y=5."],"solution_steps":[{"equation":"perpendicular to y-axis → horizontal","explanation":"Classify the line."},{"equation":"y=5","explanation":"Use the y-coordinate."}]},
    {"id":"A2G-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"Classify the slope of x=9.","answer_key":"undefined","accepted_answers":["undefined","no slope"],"diagnostic_tag":"vertical","tutor_behavior":"x=constant is vertical.","hint_steps":["x=9 is a vertical line.","Vertical lines have run 0.","The slope is undefined."],"solution_steps":[{"equation":"x=9 → vertical","explanation":"Recognize form."},{"equation":"m=undefined","explanation":"Vertical slope is undefined."}]},
    {"id":"A2G-M05","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the equation of the line through (1,-2) perpendicular to the x-axis.","answer_key":"x=1","accepted_answers":["x=1","1=x"],"diagnostic_tag":"axis_relationship","tutor_behavior":"Perpendicular to x-axis means vertical.","hint_steps":["The x-axis is horizontal.","A perpendicular line is vertical.","Through x=1, the equation is x=1."],"solution_steps":[{"equation":"perpendicular to x-axis → vertical","explanation":"Classify the line."},{"equation":"x=1","explanation":"Use the x-coordinate."}]}
  ]
}