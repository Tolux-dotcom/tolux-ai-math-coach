{
  "module_id":"alg1-a10b-multiply-polynomials","version":"1.0.0-depth-qa","course":"Algebra 1","teks":["A.10B"],"title":"Multiply Polynomials",
  "student_objective":"I can multiply first- and second-degree polynomials using exponent rules and the distributive property.",
  "teacher_objective":"Diagnose coefficient, sign, exponent, distribution, missing-product, like-term, degree, special-product, and geometric-model errors.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":true,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A10B-D01","A10B-D02","A10B-D03"],"guided_item_ids":["A10B-G01","A10B-G02","A10B-G03"],"independent_item_ids":["A10B-P01","A10B-P02","A10B-P03","A10B-P04"],"mastery_item_ids":["A10B-M01","A10B-M02","A10B-M03","A10B-M04","A10B-M05"],"assessed_items_in_core_lesson":15},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Distribution and exponent readiness"},{"step":2,"type":"concept","label":"Multiply every term"},{"step":3,"type":"worked_examples","label":"Watch Tolux expand products"},{"step":4,"type":"guided_practice","label":"Multiply with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A10B-C01","title":"Multiply monomials","content":"Multiply coefficients and add exponents on like bases: xᵐ·xⁿ=xᵐ⁺ⁿ."},
    {"id":"A10B-C02","title":"Distribute to every term","content":"A monomial outside parentheses multiplies every term inside, including each sign."},
    {"id":"A10B-C03","title":"Multiply binomials completely","content":"Multiply each term of the first polynomial by every term of the second. A box or area model can organize all partial products."},
    {"id":"A10B-C04","title":"Combine after multiplying","content":"Keep partial products separate until multiplication is complete, then combine only like terms."},
    {"id":"A10B-C05","title":"Predict and verify degree","content":"For nonzero polynomials, product degrees add. Write the result in descending powers and verify with a simple input value."}
  ],
  "items":[
    {"id":"A10B-D01","type":"diagnostic","difficulty":"Foundational","prompt":"Simplify x²·x³.","answer_key":"x⁵","accepted_answers":["x⁵","x^5"],"diagnostic_tag":"exponent_rule","critical_misconception":true,"tutor_behavior":"Add exponents when multiplying like bases."},
    {"id":"A10B-D02","type":"diagnostic","difficulty":"Foundational","prompt":"Expand 3x(x+4).","answer_key":"3x²+12x","accepted_answers":["3x²+12x","3x^2+12x"],"diagnostic_tag":"monomial_distribution","critical_misconception":true,"tutor_behavior":"Multiply 3x by both terms."},
    {"id":"A10B-D03","type":"diagnostic","difficulty":"Foundational","prompt":"How many partial products are formed when multiplying two binomials?","answer_key":"4","accepted_answers":["4","four"],"diagnostic_tag":"complete_distribution","critical_misconception":true,"tutor_behavior":"Each of two terms multiplies each of two terms."},
    {"id":"A10B-L01","type":"worked_example","difficulty":"Foundational","prompt":"Expand (x+3)(x+5).","answer_key":"x²+8x+15","accepted_answers":["x²+8x+15","x^2+8x+15"],"diagnostic_tag":"binomial_product","solution_steps":[{"equation":"x·x=x²","explanation":"Multiply the first terms."},{"equation":"5x+3x=8x","explanation":"Form and combine the two middle products."},{"equation":"3·5=15","explanation":"Multiply the constants."},{"equation":"x²+8x+15","explanation":"Write in standard form."}],"tutor_behavior":"Account explicitly for all four partial products."},
    {"id":"A10B-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Expand (2x-3)(x+4).","answer_key":"2x²+5x-12","accepted_answers":["2x²+5x-12","2x^2+5x-12"],"diagnostic_tag":"signed_binomial_product","solution_steps":[{"equation":"2x²+8x-3x-12","explanation":"Create all four signed products."},{"equation":"8x-3x=5x","explanation":"Combine the middle terms."},{"equation":"2x²+5x-12","explanation":"Write in standard form."}],"tutor_behavior":"Track the negative coefficient through both products."},
    {"id":"A10B-L03","type":"worked_example","difficulty":"Grade-level","prompt":"Expand (x+2)(x²-3x+4).","answer_key":"x³-x²-2x+8","accepted_answers":["x³-x²-2x+8","x^3-x^2-2x+8"],"diagnostic_tag":"binomial_trinomial_product","solution_steps":[{"equation":"x³-3x²+4x","explanation":"Distribute x across the trinomial."},{"equation":"2x²-6x+8","explanation":"Distribute 2 across the trinomial."},{"equation":"x³-x²-2x+8","explanation":"Combine like terms."}],"tutor_behavior":"Use rows or an area model to avoid missing a product."},
    {"id":"A10B-G01","type":"guided_practice","difficulty":"Foundational","prompt":"Expand -2x(3x-5).","answer_key":"-6x²+10x","accepted_answers":["-6x²+10x","-6x^2+10x"],"diagnostic_tag":"monomial_distribution","tutor_behavior":"A negative times -5 gives +10x."},
    {"id":"A10B-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Expand (x-6)(x+2).","answer_key":"x²-4x-12","accepted_answers":["x²-4x-12","x^2-4x-12"],"diagnostic_tag":"signed_binomial_product","critical_misconception":true,"tutor_behavior":"Combine 2x and -6x after all products are formed."},
    {"id":"A10B-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Expand (3x+1)(2x-5).","answer_key":"6x²-13x-5","accepted_answers":["6x²-13x-5","6x^2-13x-5"],"diagnostic_tag":"binomial_product","tutor_behavior":"Combine -15x and 2x."},
    {"id":"A10B-P01","type":"independent_practice","difficulty":"Foundational","prompt":"Simplify 4x²·3x.","answer_key":"12x³","accepted_answers":["12x³","12x^3"],"diagnostic_tag":"monomial_product","tutor_behavior":"Multiply coefficients and add exponents 2+1."},
    {"id":"A10B-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Expand (x+7)(x-3).","answer_key":"x²+4x-21","accepted_answers":["x²+4x-21","x^2+4x-21"],"diagnostic_tag":"signed_binomial_product","tutor_behavior":"Keep the negative constant product."},
    {"id":"A10B-P03","type":"independent_practice","difficulty":"Grade-level","prompt":"Expand (2x-1)².","answer_key":"4x²-4x+1","accepted_answers":["4x²-4x+1","4x^2-4x+1"],"diagnostic_tag":"square_of_binomial","tutor_behavior":"Treat the square as two identical binomial factors."},
    {"id":"A10B-P04","type":"independent_practice","difficulty":"Challenging","prompt":"Expand (2x+3)(x²-x+5).","answer_key":"2x³+x²+7x+15","accepted_answers":["2x³+x²+7x+15","2x^3+x^2+7x+15"],"diagnostic_tag":"binomial_trinomial_product","tutor_behavior":"Form six partial products before combining."},
    {"id":"A10B-M01","type":"mastery_check","difficulty":"Foundational","prompt":"Expand 5x(x²-2x+3).","answer_key":"5x³-10x²+15x","accepted_answers":["5x³-10x²+15x","5x^3-10x^2+15x"],"diagnostic_tag":"monomial_distribution","critical_misconception":true,"tutor_behavior":"Multiply every trinomial term by 5x."},
    {"id":"A10B-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Expand (x+4)(x-9).","answer_key":"x²-5x-36","accepted_answers":["x²-5x-36","x^2-5x-36"],"diagnostic_tag":"binomial_product","critical_misconception":true,"tutor_behavior":"Combine -9x and 4x."},
    {"id":"A10B-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Expand (3x-2)(2x+7).","answer_key":"6x²+17x-14","accepted_answers":["6x²+17x-14","6x^2+17x-14"],"diagnostic_tag":"signed_binomial_product","critical_misconception":true,"tutor_behavior":"Track all coefficient signs."},
    {"id":"A10B-M04","type":"mastery_check","difficulty":"Challenging","prompt":"Expand (x-3)(x²+2x-4).","answer_key":"x³-x²-10x+12","accepted_answers":["x³-x²-10x+12","x^3-x^2-10x+12"],"diagnostic_tag":"binomial_trinomial_product","critical_misconception":true,"tutor_behavior":"Use two complete distribution rows."},
    {"id":"A10B-M05","type":"mastery_check","difficulty":"Reasoning","prompt":"A student says (x+5)²=x²+25. Is the expansion correct?","answer_key":"no","accepted_answers":["no","incorrect","no the result is x²+10x+25"],"diagnostic_tag":"missing_middle_term","critical_misconception":true,"explanation_prompt":"Explain the missing product and give the correct expansion.","explanation_keywords":[["two factors","(x+5)(x+5)","multiply the binomials"],["5x+5x","10x","middle term"],["x²+10x+25","x^2+10x+25"]],"minimum_explanation_keyword_groups":2,"explanation_guidance":"The square means (x+5)(x+5). The two cross products are 5x and 5x, so the expansion is x²+10x+25.","tutor_behavior":"Require the two cross products and the corrected trinomial."},
    {"id":"A10B-X01","type":"depth_practice","difficulty":"Foundational","prompt":"Simplify 2x³·(-4x²).","answer_key":"-8x⁵","accepted_answers":["-8x⁵","-8x^5"],"diagnostic_tag":"monomial_product","tutor_behavior":"Multiply signed coefficients and add exponents."},
    {"id":"A10B-X02","type":"depth_practice","difficulty":"Foundational","prompt":"Expand 7(x²-x+2).","answer_key":"7x²-7x+14","accepted_answers":["7x²-7x+14","7x^2-7x+14"],"diagnostic_tag":"constant_distribution","tutor_behavior":"Multiply each term by 7."},
    {"id":"A10B-X03","type":"depth_practice","difficulty":"Grade-level","prompt":"Expand (x-4)².","answer_key":"x²-8x+16","accepted_answers":["x²-8x+16","x^2-8x+16"],"diagnostic_tag":"square_of_binomial","tutor_behavior":"The middle term is twice the product x(-4)."},
    {"id":"A10B-X04","type":"depth_practice","difficulty":"Grade-level","prompt":"Expand (x+6)(x-6).","answer_key":"x²-36","accepted_answers":["x²-36","x^2-36"],"diagnostic_tag":"difference_of_squares_product","tutor_behavior":"The opposite middle terms cancel."},
    {"id":"A10B-X05","type":"depth_practice","difficulty":"Grade-level","prompt":"What is the degree of (2x²+1)(x-3)?","answer_key":"3","accepted_answers":["3","degree 3","cubic"],"diagnostic_tag":"product_degree","tutor_behavior":"Add degrees 2 and 1."},
    {"id":"A10B-X06","type":"depth_practice","difficulty":"Grade-level","prompt":"Expand (x²+2)(x²-3).","answer_key":"x⁴-x²-6","accepted_answers":["x⁴-x²-6","x^4-x^2-6"],"diagnostic_tag":"quadratic_product","tutor_behavior":"Combine -3x² and 2x²."},
    {"id":"A10B-X07","type":"depth_practice","difficulty":"Challenging","prompt":"Expand (2x-5)(2x+5).","answer_key":"4x²-25","accepted_answers":["4x²-25","4x^2-25"],"diagnostic_tag":"difference_of_squares_product","tutor_behavior":"Recognize conjugates or verify middle-term cancellation."},
    {"id":"A10B-X08","type":"depth_practice","difficulty":"Reasoning","prompt":"Can (x+2)(x+3) have degree 3 after simplification?","answer_key":"no","accepted_answers":["no","no its degree is 2","degree 2"],"diagnostic_tag":"product_degree","tutor_behavior":"The leading product is x² and cannot cancel here."},
    {"id":"A10B-X09","type":"depth_practice","difficulty":"Reasoning","prompt":"A student multiplies x²·x³ as x⁶. State the correct result.","answer_key":"x⁵","accepted_answers":["x⁵","x^5"],"diagnostic_tag":"exponent_rule","tutor_behavior":"Add exponents for multiplication; do not multiply them."},
    {"id":"A10B-X10","type":"depth_practice","difficulty":"Context","prompt":"A rectangle has length x+5 and width x+2. Write its area.","answer_key":"x²+7x+10","accepted_answers":["x²+7x+10","x^2+7x+10"],"diagnostic_tag":"area_model","tutor_behavior":"Area is the product of length and width."},
    {"id":"A10B-X11","type":"depth_practice","difficulty":"Context","prompt":"A square has side 3x-1. Write its area.","answer_key":"9x²-6x+1","accepted_answers":["9x²-6x+1","9x^2-6x+1"],"diagnostic_tag":"area_model","tutor_behavior":"Square the entire binomial, including the middle term."},
    {"id":"A10B-X12","type":"depth_practice","difficulty":"Reasoning","prompt":"At x=1, (x+2)(x-4) and x²-2x-8 both equal -6. Is this consistent with a correct expansion?","answer_key":"yes","accepted_answers":["yes","yes it is consistent"],"diagnostic_tag":"equivalence_check","tutor_behavior":"A successful value check supports the expansion, though algebra establishes equivalence."}
  ],
  "misconception_routes":{
    "exponent_rule":{"error_code":"A10B-E01","teacher_signal":"Multiplies exponents instead of adding them","route":"exponent-rule-remediation"},
    "monomial_distribution":{"error_code":"A10B-E02","teacher_signal":"Does not distribute to every term or loses a sign","route":"monomial-distribution-remediation"},
    "complete_distribution":{"error_code":"A10B-E03","teacher_signal":"Omits a partial product","route":"complete-distribution-remediation"},
    "binomial_product":{"error_code":"A10B-E04","teacher_signal":"Forms or combines binomial products incorrectly","route":"binomial-product-remediation"},
    "signed_binomial_product":{"error_code":"A10B-E05","teacher_signal":"Mishandles negative partial products","route":"signed-product-remediation"},
    "binomial_trinomial_product":{"error_code":"A10B-E06","teacher_signal":"Misses one of six partial products","route":"binomial-trinomial-remediation"},
    "monomial_product":{"error_code":"A10B-E07","teacher_signal":"Miscalculates coefficients or exponents","route":"monomial-product-remediation"},
    "square_of_binomial":{"error_code":"A10B-E08","teacher_signal":"Omits or mis-signs the middle term","route":"binomial-square-remediation"},
    "missing_middle_term":{"error_code":"A10B-E09","teacher_signal":"Squares terms separately and omits cross products","route":"middle-term-remediation"},
    "constant_distribution":{"error_code":"A10B-E10","teacher_signal":"Fails to distribute a constant fully","route":"constant-distribution-remediation"},
    "difference_of_squares_product":{"error_code":"A10B-E11","teacher_signal":"Does not recognize cancellation in conjugates","route":"conjugate-remediation"},
    "product_degree":{"error_code":"A10B-E12","teacher_signal":"Predicts the wrong degree of a product","route":"degree-remediation"},
    "quadratic_product":{"error_code":"A10B-E13","teacher_signal":"Mishandles a product involving quadratic terms","route":"quadratic-product-remediation"},
    "area_model":{"error_code":"A10B-E14","teacher_signal":"Does not translate dimensions into a polynomial product","route":"area-model-remediation"},
    "equivalence_check":{"error_code":"A10B-E15","teacher_signal":"Cannot use substitution to check a product","route":"equivalence-check-remediation"}
  }
}
