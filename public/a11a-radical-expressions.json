  "concept_cards": [
    {"id": "A11A-C01", "title": "Know the perfect squares", "content": "Useful perfect squares include 1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121, and 144. A perfect-square factor can move out of a square root."},
    {"id": "A11A-C02", "title": "Use the largest perfect-square factor", "content": "For √72, use 72=36·2. Then √72=√36·√2=6√2. Choosing the largest perfect-square factor usually reaches simplified form in one step."},
    {"id": "A11A-C03", "title": "Multiply and divide square roots carefully", "content": "For nonnegative numbers, √a·√b=√(ab). For b>0, √a/√b=√(a/b). Simplify the resulting radical whenever possible."},
    {"id": "A11A-C04", "title": "Combine only like radicals", "content": "Simplify each radical first. Radicals can be combined only when their simplified radicands match, such as 2√3+5√3=7√3."},
    {"id": "A11A-C05", "title": "Know when a radical is simplified", "content": "A simplified square-root expression has no perfect-square factor greater than 1 left inside the radical, and all like radicals have been combined."}
  ],
  "items": [
    {
      "id": "A11A-D01", "type": "diagnostic", "difficulty": "Foundational",
      "prompt": "Evaluate √36.", "answer_key": "6",
      "accepted_answers": ["6"],
      "diagnostic_tag": "perfect_square_value", "critical_misconception": true,
      "tutor_behavior": "Ask which positive number multiplied by itself equals 36.",
      "solution_steps": [
        {"equation": "6·6=36", "explanation": "36 is a perfect square."},
        {"equation": "√36=6", "explanation": "The principal square root is the nonnegative value 6."}
      ]
    },
    {
      "id": "A11A-D02", "type": "diagnostic", "difficulty": "Foundational",
      "prompt": "What is the largest perfect-square factor of 72?", "answer_key": "36",
      "accepted_answers": ["36"],
      "diagnostic_tag": "perfect_square_factor", "critical_misconception": true,
      "tutor_behavior": "Check perfect squares that divide 72: 4, 9, and 36. Choose the largest one.",
      "solution_steps": [
        {"equation": "72=36·2", "explanation": "36 divides 72 exactly."},
        {"equation": "36=6²", "explanation": "36 is the largest perfect-square factor of 72."}
      ]
    },
    {
      "id": "A11A-D03", "type": "diagnostic", "difficulty": "Grade-level",
      "prompt": "Simplify √12.", "answer_key": "2√3",
      "accepted_answers": ["2√3", "2sqrt(3)", "2sqrt3"],
      "diagnostic_tag": "extract_square", "critical_misconception": true,
      "tutor_behavior": "Rewrite 12 as 4·3, then take √4 out of the radical.",
      "solution_steps": [
        {"equation": "√12=√(4·3)", "explanation": "Use the perfect-square factor 4."},
        {"equation": "√12=√4·√3=2√3", "explanation": "Take the square root of 4 and leave √3 inside."}
      ]
    },

    {
      "id": "A11A-L01", "type": "worked_example", "difficulty": "Grade-level",
      "prompt": "Simplify √72.", "answer_key": "6√2",
      "accepted_answers": ["6√2", "6sqrt(2)", "6sqrt2"],
      "diagnostic_tag": "extract_square",
      "solution_steps": [
        {"equation": "72=36·2", "explanation": "Choose 36 because it is the largest perfect-square factor of 72."},
        {"equation": "√72=√(36·2)", "explanation": "Rewrite the radicand using the perfect-square factor."},
        {"equation": "√72=√36·√2", "explanation": "Use the product property of square roots."},
        {"equation": "√72=6√2", "explanation": "Since √36=6 and 2 has no perfect-square factor greater than 1, the radical is simplified."}
      ],
      "tutor_behavior": "Find the largest perfect-square factor first: 72=36·2."
    },
    {
      "id": "A11A-L02", "type": "worked_example", "difficulty": "Grade-level",
      "prompt": "Simplify 2√18+√8.", "answer_key": "8√2",
      "accepted_answers": ["8√2", "8sqrt(2)", "8sqrt2"],
      "diagnostic_tag": "like_radicals",
      "solution_steps": [
        {"equation": "√18=√(9·2)=3√2", "explanation": "Simplify √18 using the perfect-square factor 9."},
        {"equation": "√8=√(4·2)=2√2", "explanation": "Simplify √8 using the perfect-square factor 4."},
        {"equation": "2√18+√8=2(3√2)+2√2", "explanation": "Substitute the simplified radicals."},
        {"equation": "6√2+2√2=8√2", "explanation": "The radicals are now like radicals, so add their coefficients."}
      ],
      "tutor_behavior": "Simplify each radical first; only then combine the matching √2 terms."
    },
    {
      "id": "A11A-L03", "type": "worked_example", "difficulty": "Grade-level",
      "prompt": "Simplify √6·√24.", "answer_key": "12",
      "accepted_answers": ["12"],
      "diagnostic_tag": "product_property",
      "solution_steps": [
        {"equation": "√6·√24=√(6·24)", "explanation": "Use the product property for nonnegative radicands."},
        {"equation": "√(6·24)=√144", "explanation": "Multiply inside the radical."},
        {"equation": "√144=12", "explanation": "144 is a perfect square because 12²=144."}
      ],
      "tutor_behavior": "Combine the radicals first: √6·√24=√144."
    },

    {
      "id": "A11A-G01", "type": "guided_practice", "difficulty": "Foundational",
      "prompt": "Simplify √48.", "answer_key": "4√3",
      "accepted_answers": ["4√3", "4sqrt(3)", "4sqrt3"],
      "diagnostic_tag": "extract_square",
      "hint_steps": ["Look for the largest perfect-square factor of 48.", "48=16·3.", "Take √16 outside the radical and leave √3 inside."],
      "alternate_solution_steps": [
        {"equation": "√48=√(16·3)", "explanation": "16 is the largest perfect-square factor."},
        {"equation": "√48=4√3", "explanation": "√16=4, and √3 cannot be simplified further."}
      ],
      "solution_steps": [
        {"equation": "48=16·3", "explanation": "Use the perfect-square factor 16."},
        {"equation": "√48=√16·√3", "explanation": "Split the radical using the product property."},
        {"equation": "√48=4√3", "explanation": "Take √16=4 outside the radical."}
      ],
      "tutor_behavior": "Start with 48=16·3, then take √16 outside."
    },
    {
      "id": "A11A-G02", "type": "guided_practice", "difficulty": "Grade-level",
      "prompt": "Simplify √27+√12.", "answer_key": "5√3",
      "accepted_answers": ["5√3", "5sqrt(3)", "5sqrt3"],
      "diagnostic_tag": "like_radicals", "critical_misconception": true,
      "hint_steps": ["Do not add the radicands. Simplify each radical separately first.", "√27=3√3 and √12=2√3.", "Now the radicals match, so add the coefficients 3 and 2."],
      "alternate_solution_steps": [
        {"equation": "√27+√12=√(9·3)+√(4·3)", "explanation": "Expose a perfect-square factor in each radicand."},
        {"equation": "3√3+2√3=5√3", "explanation": "Combine like radicals after simplifying."}
      ],
      "solution_steps": [
        {"equation": "√27=3√3", "explanation": "27=9·3."},
        {"equation": "√12=2√3", "explanation": "12=4·3."},
        {"equation": "3√3+2√3=5√3", "explanation": "Add the coefficients because the radicands are the same."}
      ],
      "tutor_behavior": "Simplify √27 and √12 separately; never turn √27+√12 into √39."
    },
    {
      "id": "A11A-G03", "type": "guided_practice", "difficulty": "Grade-level",
      "prompt": "Simplify √50/√2.", "answer_key": "5",
      "accepted_answers": ["5"],
      "diagnostic_tag": "quotient_property", "critical_misconception": true,
      "hint_steps": ["Use the quotient property because both radicands are nonnegative and the denominator is not zero.", "√50/√2=√(50/2).", "50/2=25, and √25 is a perfect square."],
      "alternate_solution_steps": [
        {"equation": "√50/√2=√25", "explanation": "Divide the radicands: 50÷2=25."},
        {"equation": "√25=5", "explanation": "5²=25."}
      ],
      "solution_steps": [
        {"equation": "√50/√2=√(50/2)", "explanation": "Apply the quotient property."},
        {"equation": "√(50/2)=√25", "explanation": "Simplify the quotient inside the radical."},
        {"equation": "√25=5", "explanation": "Take the principal square root."}
      ],
      "tutor_behavior": "Combine the quotient under one square root: √(50/2)=√25."
    },

    {
