      "alternate_solution_steps": [{"equation": "√75=√(25·3)", "explanation": "Use 25 as the perfect-square factor."}, {"equation": "√75=5√3", "explanation": "√25=5."}],
      "solution_steps": [{"equation": "75=25·3", "explanation": "25 is the largest perfect-square factor."}, {"equation": "√75=5√3", "explanation": "Take √25 outside the radical."}],
      "tutor_behavior": "Use 75=25·3, not 75=5·15, because 25 is a perfect square."
    },
    {
      "id": "A11A-P02", "type": "independent_practice", "difficulty": "Grade-level",
      "prompt": "Simplify 3√8-√18.", "answer_key": "3√2",
      "accepted_answers": ["3√2", "3sqrt(2)", "3sqrt2"],
      "diagnostic_tag": "like_radicals",
      "hint_steps": ["Simplify √8 and √18 first.", "√8=2√2 and √18=3√2.", "Compute 3(2√2)-3√2."],
      "alternate_solution_steps": [{"equation": "3√8-√18=6√2-3√2", "explanation": "Simplify both radicals."}, {"equation": "6√2-3√2=3√2", "explanation": "Subtract the coefficients of like radicals."}],
      "solution_steps": [{"equation": "3√8=3(2√2)=6√2", "explanation": "Simplify √8 first."}, {"equation": "√18=3√2", "explanation": "Simplify √18."}, {"equation": "6√2-3√2=3√2", "explanation": "Combine like radicals."}],
      "tutor_behavior": "Simplify to like radicals before subtracting."
    },
    {
      "id": "A11A-P03", "type": "independent_practice", "difficulty": "Grade-level",
      "prompt": "Simplify √15·√5.", "answer_key": "5√3",
      "accepted_answers": ["5√3", "5sqrt(3)", "5sqrt3"],
      "diagnostic_tag": "product_property",
      "hint_steps": ["Combine the two radicals into one radical.", "√15·√5=√75.", "Now simplify √75 using 75=25·3."],
      "alternate_solution_steps": [{"equation": "√15·√5=√75", "explanation": "Use the product property."}, {"equation": "√75=5√3", "explanation": "Extract the perfect-square factor 25."}],
      "solution_steps": [{"equation": "√15·√5=√75", "explanation": "Multiply the radicands."}, {"equation": "√75=√(25·3)", "explanation": "Find the perfect-square factor 25."}, {"equation": "√75=5√3", "explanation": "Simplify completely."}],
      "tutor_behavior": "First multiply under one radical, then simplify √75."
    },
    {
