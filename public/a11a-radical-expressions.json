      "solution_steps": [{"equation": "√32=4√2", "explanation": "32=16·2."}, {"equation": "√8=2√2", "explanation": "8=4·2."}, {"equation": "4√2-2√2=2√2", "explanation": "Combine like radicals."}],
      "tutor_behavior": "Use 32=16·2 and 8=4·2 so both terms become like radicals."
