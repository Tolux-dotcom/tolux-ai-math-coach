{
  "module_id":"alg1-a12d-sequence-formulas","version":"1.0.0-private-qa","course":"Algebra 1","teks":["A.12D"],"title":"Write Sequence Formulas",
  "student_objective":"I can write nth-term formulas for arithmetic and geometric sequences.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A12D-D01","A12D-D02"],"guided_item_ids":["A12D-G01","A12D-G02","A12D-G03"],"independent_item_ids":["A12D-P01","A12D-P02","A12D-P03"],"mastery_item_ids":["A12D-M01","A12D-M02","A12D-M03","A12D-M04","A12D-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Formula readiness"},{"step":2,"type":"concept","label":"Build the nth-term rule"},{"step":3,"type":"worked_examples","label":"Watch Tolux build formulas"},{"step":4,"type":"guided_practice","label":"Write formulas with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A12D-C01","title":"Arithmetic formula","content":"For an arithmetic sequence, aₙ=a₁+(n-1)d. Start with the first term, then add the common difference n-1 times."},
    {"id":"A12D-C02","title":"Geometric formula","content":"For a geometric sequence, aₙ=a₁(r)ⁿ⁻¹. Start with the first term, then multiply by the common ratio n-1 times."},
    {"id":"A12D-C03","title":"Why n-1?","content":"The first term requires zero jumps from a₁, the second term requires one jump, and the nth term requires n-1 jumps."},
    {"id":"A12D-C04","title":"Check your rule","content":"Substitute n=1. A correct nth-term rule must reproduce the first term."}
  ],
  "misconception_routes":{
    "arithmetic_formula":{"route":"arithmetic","error_code":"SEQ-FORM-A","teacher_signal":"Student mixes first term and common difference."},
    "geometric_formula":{"route":"geometric","error_code":"SEQ-FORM-G","teacher_signal":"Student uses addition instead of repeated multiplication."},
    "n_minus_one":{"route":"index","error_code":"SEQ-FORM-N","teacher_signal":"Student uses n instead of n-1."}
  },
  "items":[
    {"id":"A12D-D01","type":"diagnostic","difficulty":"Foundational","prompt":"For 5, 9, 13, 17, ... identify a₁ and d. Answer as a₁=__, d=__.","answer_key":"a₁=5,d=4","accepted_answers":["a1=5,d=4","a₁=5,d=4","5,4"],"diagnostic_tag":"arithmetic_formula","tutor_behavior":"Read the first term, then subtract consecutive terms.","hint_steps":["The first listed term is a₁.","9-5=4.","a₁=5 and d=4."],"solution_steps":[{"equation":"a₁=5","explanation":"The first term is 5."},{"equation":"d=9-5=4","explanation":"The common difference is 4."}]},
    {"id":"A12D-D02","type":"diagnostic","difficulty":"Foundational","prompt":"For 3, 12, 48, 192, ... identify a₁ and r. Answer as a₁=__, r=__.","answer_key":"a₁=3,r=4","accepted_answers":["a1=3,r=4","a₁=3,r=4","3,4"],"diagnostic_tag":"geometric_formula","tutor_behavior":"Read the first term, then divide consecutive terms.","hint_steps":["The first term is 3.","12÷3=4.","a₁=3 and r=4."],"solution_steps":[{"equation":"a₁=3","explanation":"The first term is 3."},{"equation":"r=12÷3=4","explanation":"The common ratio is 4."}]},
    {"id":"A12D-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Write an nth-term formula for 7, 12, 17, 22, ...","answer_key":"aₙ=7+5(n-1)","accepted_answers":["an=7+5(n-1)","a_n=7+5(n-1)","aₙ=7+5(n-1)","aₙ=5n+2","an=5n+2"],"diagnostic_tag":"arithmetic_formula","tutor_behavior":"Use aₙ=a₁+(n-1)d.","hint_steps":["a₁=7 and d=5.","Substitute into aₙ=a₁+(n-1)d.","aₙ=7+5(n-1)."],"solution_steps":[{"equation":"a₁=7, d=5","explanation":"Identify the sequence values."},{"equation":"aₙ=a₁+(n-1)d","explanation":"Use the arithmetic nth-term formula."},{"equation":"aₙ=7+5(n-1)","explanation":"Substitute a₁ and d."}]},
    {"id":"A12D-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Write an nth-term formula for 2, 6, 18, 54, ...","answer_key":"aₙ=2(3)ⁿ⁻¹","accepted_answers":["an=2(3)^(n-1)","a_n=2(3)^(n-1)","aₙ=2(3)ⁿ⁻¹","2*3^(n-1)","2(3)^(n-1)"],"diagnostic_tag":"geometric_formula","tutor_behavior":"Use aₙ=a₁(r)ⁿ⁻¹.","hint_steps":["a₁=2 and r=3.","Use aₙ=a₁(r)ⁿ⁻¹.","aₙ=2(3)ⁿ⁻¹."],"solution_steps":[{"equation":"a₁=2, r=3","explanation":"Identify the first term and ratio."},{"equation":"aₙ=a₁(r)ⁿ⁻¹","explanation":"Use the geometric nth-term formula."},{"equation":"aₙ=2(3)ⁿ⁻¹","explanation":"Substitute the values."}]},
    {"id":"A12D-L03","type":"worked_example","difficulty":"Challenging","prompt":"Write an nth-term formula for 81, 27, 9, 3, ...","answer_key":"aₙ=81(1/3)ⁿ⁻¹","accepted_answers":["an=81(1/3)^(n-1)","a_n=81(1/3)^(n-1)","aₙ=81(1/3)ⁿ⁻¹","81(1/3)^(n-1)"],"diagnostic_tag":"geometric_formula","tutor_behavior":"The ratio can be a fraction.","hint_steps":["27÷81=1/3.","a₁=81 and r=1/3.","aₙ=81(1/3)ⁿ⁻¹."],"solution_steps":[{"equation":"r=27÷81=1/3","explanation":"Find the common ratio."},{"equation":"aₙ=81(1/3)ⁿ⁻¹","explanation":"Substitute into the geometric formula."}]},
    {"id":"A12D-G01","type":"guided_practice","difficulty":"Foundational","prompt":"Write an nth-term formula for 10, 13, 16, 19, ...","answer_key":"aₙ=10+3(n-1)","accepted_answers":["an=10+3(n-1)","a_n=10+3(n-1)","aₙ=10+3(n-1)","aₙ=3n+7","an=3n+7"],"diagnostic_tag":"arithmetic_formula","tutor_behavior":"Use the first term and common difference.","hint_steps":["a₁=10, d=3.","Use aₙ=a₁+(n-1)d.","aₙ=10+3(n-1)."],"solution_steps":[{"equation":"a₁=10,d=3","explanation":"Identify the values."},{"equation":"aₙ=10+3(n-1)","explanation":"Substitute into the formula."}]},
    {"id":"A12D-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Write an nth-term formula for 5, 20, 80, 320, ...","answer_key":"aₙ=5(4)ⁿ⁻¹","accepted_answers":["an=5(4)^(n-1)","a_n=5(4)^(n-1)","aₙ=5(4)ⁿ⁻¹","5(4)^(n-1)"],"diagnostic_tag":"geometric_formula","tutor_behavior":"Use first term 5 and ratio 4.","hint_steps":["r=4.","Use aₙ=a₁(r)ⁿ⁻¹.","aₙ=5(4)ⁿ⁻¹."],"solution_steps":[{"equation":"a₁=5,r=4","explanation":"Identify the values."},{"equation":"aₙ=5(4)ⁿ⁻¹","explanation":"Substitute into the formula."}]},
    {"id":"A12D-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Why does the exponent in a geometric nth-term formula use n-1 instead of n? Answer briefly.","answer_key":"because the first term has zero multiplications by the ratio","accepted_answers":["because the first term has zero multiplications by the ratio","the first term needs zero ratio steps","there are n-1 jumps from the first term","n-1 jumps"],"diagnostic_tag":"n_minus_one","tutor_behavior":"Count how many ratio steps occur from a₁ to aₙ.","hint_steps":["At n=1 no ratio has been applied yet.","At n=2 the ratio is applied once.","So the nth term requires n-1 ratio steps."],"solution_steps":[{"equation":"n=1 → 0 ratio steps","explanation":"The first term is already known."},{"equation":"n → n-1 ratio steps","explanation":"Each later term adds one multiplication."}]},
    {"id":"A12D-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Write an nth-term formula for 20, 14, 8, 2, ...","answer_key":"aₙ=20-6(n-1)","accepted_answers":["an=20-6(n-1)","a_n=20-6(n-1)","aₙ=20-6(n-1)","aₙ=26-6n","an=26-6n"],"diagnostic_tag":"arithmetic_formula","tutor_behavior":"The common difference is negative.","hint_steps":["d=-6.","Use aₙ=a₁+(n-1)d.","aₙ=20-6(n-1)."],"solution_steps":[{"equation":"a₁=20,d=-6","explanation":"Identify the values."},{"equation":"aₙ=20-6(n-1)","explanation":"Substitute the negative difference."}]},
    {"id":"A12D-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Write an nth-term formula for 64, 32, 16, 8, ...","answer_key":"aₙ=64(1/2)ⁿ⁻¹","accepted_answers":["an=64(1/2)^(n-1)","a_n=64(1/2)^(n-1)","aₙ=64(1/2)ⁿ⁻¹","64(1/2)^(n-1)"],"diagnostic_tag":"geometric_formula","tutor_behavior":"Use ratio 1/2.","hint_steps":["r=1/2.","Use aₙ=a₁(r)ⁿ⁻¹.","aₙ=64(1/2)ⁿ⁻¹."],"solution_steps":[{"equation":"a₁=64,r=1/2","explanation":"Identify the values."},{"equation":"aₙ=64(1/2)ⁿ⁻¹","explanation":"Substitute into the formula."}]},
    {"id":"A12D-P03","type":"independent_practice","difficulty":"Challenging","prompt":"An arithmetic sequence has a₁=-3 and d=7. Write its nth-term formula.","answer_key":"aₙ=-3+7(n-1)","accepted_answers":["an=-3+7(n-1)","a_n=-3+7(n-1)","aₙ=-3+7(n-1)","aₙ=7n-10","an=7n-10"],"diagnostic_tag":"arithmetic_formula","tutor_behavior":"Substitute the given first term and difference directly.","hint_steps":["a₁=-3 and d=7 are already given.","Use aₙ=a₁+(n-1)d.","aₙ=-3+7(n-1)."],"solution_steps":[{"equation":"aₙ=-3+7(n-1)","explanation":"Substitute the given values."}]},
    {"id":"A12D-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Write an nth-term formula for 9, 15, 21, 27, ...","answer_key":"aₙ=9+6(n-1)","accepted_answers":["an=9+6(n-1)","a_n=9+6(n-1)","aₙ=9+6(n-1)","aₙ=6n+3","an=6n+3"],"diagnostic_tag":"arithmetic_formula","tutor_behavior":"Use a₁=9 and d=6.","hint_steps":["d=6.","Use the arithmetic formula.","aₙ=9+6(n-1)."],"solution_steps":[{"equation":"aₙ=9+6(n-1)","explanation":"Substitute first term and difference."}]},
    {"id":"A12D-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Write an nth-term formula for 4, 12, 36, 108, ...","answer_key":"aₙ=4(3)ⁿ⁻¹","accepted_answers":["an=4(3)^(n-1)","a_n=4(3)^(n-1)","aₙ=4(3)ⁿ⁻¹","4(3)^(n-1)"],"diagnostic_tag":"geometric_formula","tutor_behavior":"Use ratio 3.","hint_steps":["r=3.","Use the geometric formula.","aₙ=4(3)ⁿ⁻¹."],"solution_steps":[{"equation":"aₙ=4(3)ⁿ⁻¹","explanation":"Substitute first term and ratio."}]},
    {"id":"A12D-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Write an nth-term formula for 50, 42, 34, 26, ...","answer_key":"aₙ=50-8(n-1)","accepted_answers":["an=50-8(n-1)","a_n=50-8(n-1)","aₙ=50-8(n-1)","aₙ=58-8n","an=58-8n"],"diagnostic_tag":"arithmetic_formula","tutor_behavior":"Use d=-8.","hint_steps":["d=-8.","Use aₙ=a₁+(n-1)d.","aₙ=50-8(n-1)."],"solution_steps":[{"equation":"aₙ=50-8(n-1)","explanation":"Substitute the negative difference."}]},
    {"id":"A12D-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"Write an nth-term formula for 125, 25, 5, 1, ...","answer_key":"aₙ=125(1/5)ⁿ⁻¹","accepted_answers":["an=125(1/5)^(n-1)","a_n=125(1/5)^(n-1)","aₙ=125(1/5)ⁿ⁻¹","125(1/5)^(n-1)"],"diagnostic_tag":"geometric_formula","tutor_behavior":"Use ratio 1/5.","hint_steps":["r=1/5.","Use the geometric formula.","aₙ=125(1/5)ⁿ⁻¹."],"solution_steps":[{"equation":"aₙ=125(1/5)ⁿ⁻¹","explanation":"Substitute the ratio."}]},
    {"id":"A12D-M05","type":"mastery_check","difficulty":"Challenging","prompt":"A geometric sequence has a₁=-2 and r=-3. Write its nth-term formula.","answer_key":"aₙ=-2(-3)ⁿ⁻¹","accepted_answers":["an=-2(-3)^(n-1)","a_n=-2(-3)^(n-1)","aₙ=-2(-3)ⁿ⁻¹","-2(-3)^(n-1)"],"diagnostic_tag":"geometric_formula","tutor_behavior":"Keep the negative ratio inside parentheses.","hint_steps":["a₁=-2 and r=-3.","Use aₙ=a₁(r)ⁿ⁻¹.","aₙ=-2(-3)ⁿ⁻¹."],"solution_steps":[{"equation":"aₙ=-2(-3)ⁿ⁻¹","explanation":"Parentheses preserve the negative ratio."}]}
  ]
}