      "solution_steps": [{"equation":"g(-3)=(-3)²-5","explanation":"Substitute -3 using parentheses."},{"equation":"g(-3)=9-5","explanation":"Square the entire negative input."},{"equation":"g(-3)=4","explanation":"Subtract."}],
      "tutor_behavior": "Use parentheses around a negative input before applying an exponent."
    },
    {
