  "concept_cards": [
    {"id": "A12B-C01", "title": "What f(3) means", "content": "f(3) means evaluate the function when the input x is 3. It does not mean f times 3."},
    {"id": "A12B-C02", "title": "Substitute everywhere", "content": "Replace every x in the rule with the given input before simplifying."},
    {"id": "A12B-C03", "title": "Negative inputs need parentheses", "content": "If the input is -2, write (-2) everywhere x appears. Parentheses protect the sign."},
    {"id": "A12B-C04", "title": "Order of operations still applies", "content": "After substitution, simplify exponents first, then multiplication or division, then addition or subtraction."},
    {"id": "A12B-C05", "title": "Several inputs", "content": "When asked for f(a), f(b), and f(c), evaluate each input separately and report the outputs in the same order."},
    {"id": "A12B-C06", "title": "Read values from a table", "content": "If a function is given by a table, f(2) is the output in the row where the input is 2."}
  ],
  "misconception_routes": {
    "notation_meaning": {"error_code": "FN-NOTATION", "teacher_signal": "Treats f(x) like multiplication", "route": "function_notation"},
    "substitution": {"error_code": "FN-SUB", "teacher_signal": "Does not substitute the input everywhere", "route": "substitution"},
    "negative_input": {"error_code": "FN-NEG", "teacher_signal": "Loses a sign or omits parentheses", "route": "negative_input"},
    "order_operations": {"error_code": "FN-ORDER", "teacher_signal": "Simplifies in the wrong order", "route": "order_operations"},
    "multiple_inputs": {"error_code": "FN-MULTI", "teacher_signal": "Mixes outputs or input order", "route": "multiple_inputs"},
    "table_lookup": {"error_code": "FN-TABLE", "teacher_signal": "Reads the wrong table row or column", "route": "table_lookup"}
  },
