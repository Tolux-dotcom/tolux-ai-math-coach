  "title":"Graph Linear Functions and Key Features",
  "student_objective":"I can graph linear functions and identify slope, intercepts, and zeros in mathematical and real-world situations.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A3C-D01","A3C-D02"],"guided_item_ids":["A3C-G01","A3C-G02","A3C-G03"],"independent_item_ids":["A3C-P01","A3C-P02","A3C-P03"],"mastery_item_ids":["A3C-M01","A3C-M02","A3C-M03","A3C-M04","A3C-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Graphing readiness"},{"step":2,"type":"concept","label":"Graph from slope and intercepts"},{"step":3,"type":"worked_examples","label":"Watch Tolux build and read a graph"},{"step":4,"type":"guided_practice","label":"Graph and identify features with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A3C-C01","title":"Start with y=mx+b","content":"The y-intercept b gives the first plotted point (0,b). The slope m tells how to move from that point using rise/run."},
    {"id":"A3C-C02","title":"Slope draws the direction","content":"Positive slope rises left to right. Negative slope falls. A fraction such as 2/3 means rise 2, run 3."},
    {"id":"A3C-C03","title":"Intercepts and zero","content":"The y-intercept is where x=0. The x-intercept is where y=0. For a function graph, the x-intercept is also called the zero."},
    {"id":"A3C-C04","title":"Use tables and context","content":"A table gives points directly. In a real situation, label axes with units and graph only meaningful input values when context restricts the domain."}
  ],
  "misconception_routes":{
    "intercept":{"route":"intercept","error_code":"GRAPH-INT","teacher_signal":"Student plots b on the wrong axis."},
    "slope":{"route":"slope","error_code":"GRAPH-SLOPE","teacher_signal":"Student uses run/rise or wrong sign."},
    "zero":{"route":"zero","error_code":"GRAPH-ZERO","teacher_signal":"Student confuses x- and y-intercepts."},
    "context":{"route":"context","error_code":"GRAPH-CONTEXT","teacher_signal":"Student ignores graph restrictions or units."}
  },
  "items":[
    {"id":"A3C-D01","type":"diagnostic","difficulty":"Foundational","prompt":"For y=2x-3, what is the y-intercept? Answer as a number.","answer_key":"-3","accepted_answers":["-3"],"diagnostic_tag":"intercept","tutor_behavior":"In y=mx+b, b is the y-intercept.","hint_steps":["Find b in y=2x-3.","b=-3.","The y-intercept is -3."],"solution_steps":[{"equation":"b=-3","explanation":"Read the constant term."},{"equation":"(0,-3)","explanation":"This is the intercept point."}]},
    {"id":"A3C-D02","type":"diagnostic","difficulty":"Foundational","prompt":"For y=2x-3, what is the slope?","answer_key":"2","accepted_answers":["2"],"diagnostic_tag":"slope","tutor_behavior":"The coefficient of x is the slope.","hint_steps":["Find m in y=2x-3.","m=2.","Slope=2."],"solution_steps":[{"equation":"m=2","explanation":"Read the x coefficient."}]},
    {"id":"A3C-L01","type":"worked_example","difficulty":"Grade-level","prompt":"For y=2x-2, state the y-intercept point.","answer_key":"(0,-2)","accepted_answers":["(0,-2)","0,-2"],"diagnostic_tag":"intercept","tutor_behavior":"Set x=0 to locate the y-intercept.","hint_steps":["y=2(0)-2=-2.","The y-axis point has x=0.","The point is (0,-2)."],"solution_steps":[{"equation":"x=0 → y=-2","explanation":"Evaluate at the y-axis."},{"equation":"(0,-2)","explanation":"Plot the intercept."}]},
    {"id":"A3C-L02","type":"worked_example","difficulty":"Grade-level","prompt":"For y=2x-2, starting at (0,-2), use slope 2=2/1. What is the next point one unit to the right?","answer_key":"(1,0)","accepted_answers":["(1,0)","1,0"],"diagnostic_tag":"slope","tutor_behavior":"Rise 2 and run 1 from the intercept.","hint_steps":["Start at (0,-2).","Run right 1 to x=1.","Rise 2 to y=0, giving (1,0)."],"solution_steps":[{"equation":"(0,-2) → right 1","explanation":"Apply run."},{"equation":"up 2 → (1,0)","explanation":"Apply rise."}]},
    {"id":"A3C-L03","type":"worked_example","difficulty":"Grade-level","prompt":"For y=-x+4, what is the x-intercept (zero)? Answer as a number.","answer_key":"4","accepted_answers":["4","x=4"],"diagnostic_tag":"zero","tutor_behavior":"Set y=0 and solve for x.","hint_steps":["0=-x+4.","x=4.","The zero is 4 at point (4,0)."],"solution_steps":[{"equation":"0=-x+4","explanation":"Set y=0."},{"equation":"x=4","explanation":"Solve."},{"equation":"(4,0)","explanation":"This is the x-intercept."}]},
    {"id":"A3C-G01","type":"guided_practice","difficulty":"Grade-level","prompt":"For y=3x+1, what point is the y-intercept?","answer_key":"(0,1)","accepted_answers":["(0,1)","0,1"],"diagnostic_tag":"intercept","tutor_behavior":"Use b=1.","hint_steps":["b=1.","The y-intercept has x=0.","(0,1)."],"solution_steps":[{"equation":"(0,1)","explanation":"Plot b on the y-axis."}]},
    {"id":"A3C-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"For y=-2x+5, starting at (0,5), move right 1 using slope -2. What is the next point?","answer_key":"(1,3)","accepted_answers":["(1,3)","1,3"],"diagnostic_tag":"slope","tutor_behavior":"Slope -2 means down 2 for right 1.","hint_steps":["Start (0,5).","Move right 1.","Move down 2 to (1,3)."],"solution_steps":[{"equation":"(0,5) → right 1","explanation":"Run."},{"equation":"down 2 → (1,3)","explanation":"Rise is -2."}]},
    {"id":"A3C-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"For y=(1/2)x-3, what is the x-intercept (zero)?","answer_key":"6","accepted_answers":["6","x=6"],"diagnostic_tag":"zero","tutor_behavior":"Set y=0.","hint_steps":["0=(1/2)x-3.","3=(1/2)x.","x=6."],"solution_steps":[{"equation":"3=(1/2)x","explanation":"Add 3."},{"equation":"x=6","explanation":"Multiply by 2."}]},
    {"id":"A3C-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"For y=-3x+6, state the y-intercept point.","answer_key":"(0,6)","accepted_answers":["(0,6)","0,6"],"diagnostic_tag":"intercept","tutor_behavior":"Use b=6.","hint_steps":["b=6.","The y-axis has x=0.","(0,6)."],"solution_steps":[{"equation":"(0,6)","explanation":"Y-intercept."}]},
    {"id":"A3C-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"For y=x-4, what is the x-intercept (zero)?","answer_key":"4","accepted_answers":["4","x=4"],"diagnostic_tag":"zero","tutor_behavior":"Set y=0.","hint_steps":["0=x-4.","x=4.","Zero=4."],"solution_steps":[{"equation":"x=4","explanation":"Solve for zero."}]},
    {"id":"A3C-P03","type":"independent_practice","difficulty":"Challenging","prompt":"A line has y-intercept (0,2) and slope -1/2. Starting at the intercept, move right 2. What is the next point?","answer_key":"(2,1)","accepted_answers":["(2,1)","2,1"],"diagnostic_tag":"slope","tutor_behavior":"Slope -1/2 means down 1 for every right 2.","hint_steps":["Start (0,2).","Run +2.","Rise -1, giving (2,1)."],"solution_steps":[{"equation":"(0,2) → right 2","explanation":"Run."},{"equation":"down 1 → (2,1)","explanation":"Use slope -1/2."}]},
    {"id":"A3C-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"For y=4x-5, what is the y-intercept point?","answer_key":"(0,-5)","accepted_answers":["(0,-5)","0,-5"],"diagnostic_tag":"intercept","tutor_behavior":"Use b=-5.","hint_steps":["b=-5.","x=0 at the y-intercept.","(0,-5)."],"solution_steps":[{"equation":"(0,-5)","explanation":"Y-intercept."}]},
    {"id":"A3C-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"For y=-x+2, what is the x-intercept (zero)?","answer_key":"2","accepted_answers":["2","x=2"],"diagnostic_tag":"zero","tutor_behavior":"Set y=0.","hint_steps":["0=-x+2.","x=2.","Zero=2."],"solution_steps":[{"equation":"x=2","explanation":"Solve."}]},
    {"id":"A3C-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"For y=(2/3)x+1, starting at (0,1), move right 3. What is the next point?","answer_key":"(3,3)","accepted_answers":["(3,3)","3,3"],"diagnostic_tag":"slope","tutor_behavior":"Slope 2/3 means rise 2 for run 3.","hint_steps":["Start (0,1).","Run +3.","Rise +2 to (3,3)."],"solution_steps":[{"equation":"(0,1) → right 3","explanation":"Run."},{"equation":"up 2 → (3,3)","explanation":"Rise."}]},
    {"id":"A3C-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"A graph crosses the y-axis at -2 and rises 1 for every run of 2. Write its equation.","answer_key":"y=(1/2)x-2","accepted_answers":["y=(1/2)x-2","y=0.5x-2","y=x/2-2"],"diagnostic_tag":"slope","tutor_behavior":"Use m=1/2 and b=-2.","hint_steps":["m=1/2.","b=-2.","y=(1/2)x-2."],"solution_steps":[{"equation":"y=mx+b","explanation":"Use slope-intercept form."},{"equation":"y=(1/2)x-2","explanation":"Substitute m and b."}]},
    {"id":"A3C-M05","type":"mastery_check","difficulty":"Grade-level","prompt":"For y=-2x+8, what is the zero?","answer_key":"4","accepted_answers":["4","x=4"],"diagnostic_tag":"zero","tutor_behavior":"Set y=0.","hint_steps":["0=-2x+8.","2x=8.","x=4."],"solution_steps":[{"equation":"2x=8","explanation":"Move -2x."},{"equation":"x=4","explanation":"Divide by 2."}]}
  ]
}