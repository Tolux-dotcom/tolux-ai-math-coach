{
  "module_id":"alg1-a12c-sequence-terms","version":"1.0.0-private-qa","course":"Algebra 1","teks":["A.12C"],"title":"Terms of Arithmetic and Geometric Sequences",
  "student_objective":"I can determine terms of arithmetic and geometric sequences from patterns, rules, and recursive descriptions.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A12C-D01","A12C-D02"],"guided_item_ids":["A12C-G01","A12C-G02","A12C-G03"],"independent_item_ids":["A12C-P01","A12C-P02","A12C-P03"],"mastery_item_ids":["A12C-M01","A12C-M02","A12C-M03","A12C-M04","A12C-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Sequence readiness"},{"step":2,"type":"concept","label":"Difference or ratio?"},{"step":3,"type":"worked_examples","label":"Watch Tolux trace patterns"},{"step":4,"type":"guided_practice","label":"Find terms with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A12C-C01","title":"Arithmetic sequence","content":"An arithmetic sequence changes by the same difference each step. Example: 5, 8, 11, 14 has common difference 3."},
    {"id":"A12C-C02","title":"Geometric sequence","content":"A geometric sequence changes by the same nonzero ratio each step. Example: 2, 6, 18, 54 has common ratio 3."},
    {"id":"A12C-C03","title":"Recursive thinking","content":"To move from one term to the next, arithmetic sequences add the common difference; geometric sequences multiply by the common ratio."},
    {"id":"A12C-C04","title":"Term number matters","content":"The first listed value is a₁. Count carefully before deciding which term is requested."}
  ],
  "misconception_routes":{
    "difference_vs_ratio":{"route":"classify","error_code":"SEQ-CLASSIFY","teacher_signal":"Student confuses constant difference with constant ratio."},
    "term_index":{"route":"index","error_code":"SEQ-INDEX","teacher_signal":"Student miscounts the requested term."},
    "recursive_step":{"route":"recursive","error_code":"SEQ-RECUR","teacher_signal":"Student applies the wrong repeated operation."}
  },
  "items":[
    {"id":"A12C-D01","type":"diagnostic","difficulty":"Foundational","prompt":"The sequence is 4, 7, 10, 13, ... Is it arithmetic or geometric?","answer_key":"arithmetic","accepted_answers":["arithmetic","arithmetic sequence"],"diagnostic_tag":"difference_vs_ratio","tutor_behavior":"Compare consecutive differences first.","hint_steps":["Subtract consecutive terms.","7-4=3 and 10-7=3.","The difference stays 3, so the sequence is arithmetic."],"solution_steps":[{"equation":"7-4=3, 10-7=3, 13-10=3","explanation":"The same difference appears each time."},{"equation":"arithmetic","explanation":"A constant difference identifies an arithmetic sequence."}]},
    {"id":"A12C-D02","type":"diagnostic","difficulty":"Foundational","prompt":"The sequence is 3, 12, 48, 192, ... What is the common ratio?","answer_key":"4","accepted_answers":["4","r=4"],"diagnostic_tag":"difference_vs_ratio","tutor_behavior":"Divide a term by the previous term.","hint_steps":["Use division, not subtraction.","12÷3=4 and 48÷12=4.","The common ratio is 4."],"solution_steps":[{"equation":"12÷3=4","explanation":"Compare consecutive terms by division."},{"equation":"48÷12=4","explanation":"The same ratio repeats."},{"equation":"r=4","explanation":"The common ratio is 4."}]},
    {"id":"A12C-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Find the 6th term of 5, 9, 13, 17, ...","answer_key":"25","diagnostic_tag":"term_index","tutor_behavior":"Identify the common difference and count terms carefully.","hint_steps":["The difference is 4.","Continue: 21 is the 5th term.","The 6th term is 25."],"solution_steps":[{"equation":"d=4","explanation":"Each term increases by 4."},{"equation":"a₅=21","explanation":"Add 4 once more after 17."},{"equation":"a₆=25","explanation":"Add 4 again."}]},
    {"id":"A12C-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Find the 5th term of 2, 6, 18, 54, ...","answer_key":"162","diagnostic_tag":"recursive_step","tutor_behavior":"Use the common ratio repeatedly.","hint_steps":["The ratio is 3.","Multiply 54 by 3.","The 5th term is 162."],"solution_steps":[{"equation":"r=3","explanation":"Each term is multiplied by 3."},{"equation":"54×3=162","explanation":"Move from the 4th term to the 5th term."},{"equation":"a₅=162","explanation":"That is the requested term."}]},
    {"id":"A12C-L03","type":"worked_example","difficulty":"Challenging","prompt":"A sequence begins a₁=40 and each term is half the previous term. Find a₄.","answer_key":"5","diagnostic_tag":"recursive_step","tutor_behavior":"Apply the ratio 1/2 three times after the first term.","hint_steps":["a₂=20.","a₃=10.","a₄=5."],"solution_steps":[{"equation":"40×1/2=20","explanation":"Find a₂."},{"equation":"20×1/2=10","explanation":"Find a₃."},{"equation":"10×1/2=5","explanation":"Find a₄."}]},
    {"id":"A12C-G01","type":"guided_practice","difficulty":"Foundational","prompt":"Find the next term: 18, 14, 10, 6, ...","answer_key":"2","diagnostic_tag":"difference_vs_ratio","tutor_behavior":"Look for a constant difference.","hint_steps":["14-18=-4.","The sequence subtracts 4 each time.","6-4=2, so the next term is 2."],"solution_steps":[{"equation":"d=-4","explanation":"The common difference is -4."},{"equation":"6+(-4)=2","explanation":"Apply the difference once more."}]},
    {"id":"A12C-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Find the 6th term: 1, 3, 9, 27, ...","answer_key":"243","diagnostic_tag":"term_index","tutor_behavior":"Count the listed terms before continuing the ratio.","hint_steps":["The ratio is 3.","The 5th term is 81.","The 6th term is 243."],"solution_steps":[{"equation":"a₅=27×3=81","explanation":"Continue the geometric pattern."},{"equation":"a₆=81×3=243","explanation":"Continue one more step."}]},
    {"id":"A12C-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"A sequence starts 12, 17, 22, 27, ... Find a₈.","answer_key":"47","diagnostic_tag":"term_index","tutor_behavior":"Use the common difference and count to the 8th term.","hint_steps":["The difference is 5.","a₅=32, a₆=37, a₇=42.","a₈=47."],"solution_steps":[{"equation":"d=5","explanation":"The sequence is arithmetic."},{"equation":"27→32→37→42→47","explanation":"Continue four more terms."},{"equation":"a₈=47","explanation":"The 8th term is 47."}]},
    {"id":"A12C-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Find a₇ for 30, 25, 20, 15, ...","answer_key":"0","diagnostic_tag":"term_index","tutor_behavior":"Continue subtracting 5 until the 7th term.","hint_steps":["d=-5.","a₅=10 and a₆=5.","a₇=0."],"solution_steps":[{"equation":"15→10→5→0","explanation":"Continue the constant difference -5."},{"equation":"a₇=0","explanation":"Count to the 7th term."}]},
    {"id":"A12C-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Find a₆ for 5, 10, 20, 40, ...","answer_key":"160","diagnostic_tag":"recursive_step","tutor_behavior":"Multiply by 2 for each new term.","hint_steps":["r=2.","a₅=80.","a₆=160."],"solution_steps":[{"equation":"40×2=80","explanation":"Find a₅."},{"equation":"80×2=160","explanation":"Find a₆."}]},
    {"id":"A12C-P03","type":"independent_practice","difficulty":"Challenging","prompt":"A geometric sequence has a₁=81 and ratio 1/3. Find a₅.","answer_key":"1","diagnostic_tag":"recursive_step","tutor_behavior":"Multiply by 1/3 four times after the first term.","hint_steps":["81→27→9.","Then 9→3.","Then 3→1, so a₅=1."],"solution_steps":[{"equation":"81,27,9,3,1","explanation":"Apply the ratio 1/3 repeatedly."},{"equation":"a₅=1","explanation":"The fifth value is 1."}]},
    {"id":"A12C-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Find a₉ for 6, 10, 14, 18, ...","answer_key":"38","diagnostic_tag":"term_index","tutor_behavior":"Use the constant difference 4.","hint_steps":["d=4.","Continue to the 9th term.","a₉=38."],"solution_steps":[{"equation":"6,10,14,18,22,26,30,34,38","explanation":"Add 4 each time."}]},
    {"id":"A12C-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Find a₇ for 4, 8, 16, 32, ...","answer_key":"256","diagnostic_tag":"term_index","tutor_behavior":"Use ratio 2.","hint_steps":["r=2.","a₅=64 and a₆=128.","a₇=256."],"solution_steps":[{"equation":"32→64→128→256","explanation":"Multiply by 2 each step."}]},
    {"id":"A12C-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"The sequence 50, 43, 36, 29, ... is arithmetic. What is the common difference?","answer_key":"-7","accepted_answers":["-7","d=-7"],"diagnostic_tag":"difference_vs_ratio","tutor_behavior":"Subtract consecutive terms.","hint_steps":["43-50=-7.","36-43=-7.","The common difference is -7."],"solution_steps":[{"equation":"43-50=-7","explanation":"Subtract consecutive terms."}]},
    {"id":"A12C-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"The sequence 7, 21, 63, 189, ... is geometric. What is the common ratio?","answer_key":"3","accepted_answers":["3","r=3"],"diagnostic_tag":"difference_vs_ratio","tutor_behavior":"Divide consecutive terms.","hint_steps":["21÷7=3.","63÷21=3.","The common ratio is 3."],"solution_steps":[{"equation":"21÷7=3","explanation":"Divide a term by the previous term."}]},
    {"id":"A12C-M05","type":"mastery_check","difficulty":"Challenging","prompt":"A sequence starts a₁=96 and each term is one fourth of the previous term. Find a₄.","answer_key":"1.5","accepted_answers":["1.5","3/2"],"diagnostic_tag":"recursive_step","tutor_behavior":"Apply the ratio 1/4 three times.","hint_steps":["a₂=24.","a₃=6.","a₄=1.5."],"solution_steps":[{"equation":"96→24→6→1.5","explanation":"Multiply by 1/4 each step."}]}
  ]
}