    {
      "id": "A5A-L01",
      "type": "worked_example",
      "difficulty": "Foundational",
      "prompt": "Solve 3x + 5 = 20.",
      "answer_key": "x = 5",
      "diagnostic_tag": "inverse_operations",
      "tutor_behavior": "Explain subtract 5 from both sides, then divide both sides by 3; verify.",
      "solution_steps": [
        {
          "equation": "3x + 5 = 20",
          "explanation": "Start with the original equation."
        },
        {
          "equation": "3x + 5 - 5 = 20 - 5",
          "explanation": "Subtract 5 from both sides to keep the equation balanced."
        },
        {
          "equation": "3x = 15",
          "explanation": "Simplify both sides."
        },
        {
          "equation": "3x / 3 = 15 / 3",
          "explanation": "Divide both sides by 3."
        },
        {
          "equation": "x = 5",
          "explanation": "The variable is isolated."
        },
        {
          "equation": "3(5) + 5 = 20 ✓",
          "explanation": "Substitute 5 into the original equation to verify the solution."
        }
      ],
      "process_teks_tags": [
        "A.1B",
        "A.1D",
        "A.1G"
      ]
    },
    {
      "id": "A5A-L02",
      "type": "worked_example",
      "difficulty": "Grade-level",
      "prompt": "Solve 4(2x - 3) = 20.",
      "answer_key": "x = 4",
      "diagnostic_tag": "distribution",
      "tutor_behavior": "Model distribution, combine, isolate x, verify.",
      "solution_steps": [
        {
          "equation": "4(2x - 3) = 20",
          "explanation": "Start with the original equation."
        },
        {
          "equation": "8x - 12 = 20",
          "explanation": "Distribute 4 to both terms inside the parentheses."
        },
        {
          "equation": "8x - 12 + 12 = 20 + 12",
          "explanation": "Add 12 to both sides."
        },
        {
          "equation": "8x = 32",
          "explanation": "Simplify both sides."
        },
        {
          "equation": "x = 4",
          "explanation": "Divide both sides by 8."
        },
        {
          "equation": "4(2(4) - 3) = 20 ✓",
          "explanation": "Check the solution in the original equation."
        }
      ],
      "process_teks_tags": [
        "A.1B",
        "A.1D",
        "A.1G"
      ]
    },
    {
      "id": "A5A-L03",
      "type": "worked_example",
      "difficulty": "Grade-level",
      "prompt": "Solve 5x + 7 = 2x + 25.",
      "answer_key": "x = 6",
      "diagnostic_tag": "variables_both_sides",
      "tutor_behavior": "Ask which variable term to move first and why.",
      "solution_steps": [
        {
          "equation": "5x + 7 = 2x + 25",
          "explanation": "Start with the original equation."
        },
        {
          "equation": "5x - 2x + 7 = 2x - 2x + 25",
          "explanation": "Subtract 2x from both sides."
        },
        {
          "equation": "3x + 7 = 25",
          "explanation": "Combine like terms."
        },
        {
          "equation": "3x + 7 - 7 = 25 - 7",
          "explanation": "Subtract 7 from both sides."
        },
        {
          "equation": "3x = 18",
          "explanation": "Simplify both sides."
        },
        {
          "equation": "x = 6",
          "explanation": "Divide both sides by 3."
        },
        {
          "equation": "5(6) + 7 = 2(6) + 25 ✓",
          "explanation": "Check the solution in the original equation."
        }
      ],
      "process_teks_tags": [
        "A.1B",
        "A.1D",
        "A.1G"
      ]
    },
    {
      "id": "A5A-G01",
      "type": "guided_practice",
      "difficulty": "Grade-level",
      "prompt": "Solve 2(x + 4) = 18. You may divide first or distribute first.",
      "answer_key": "x = 5",
      "diagnostic_tag": "distribution_or_division",
      "tutor_behavior": "Accept either valid efficient path; ask student for first step before revealing solution.",
      "solution_steps": [
        {
          "equation": "2(x + 4) = 18",
          "explanation": "Start with the original equation."
        },
        {
          "equation": "x + 4 = 9",
          "explanation": "Divide both sides by 2 first. Distribution would also be valid."
        },
        {
          "equation": "x = 5",
          "explanation": "Subtract 4 from both sides."
        },
        {
          "equation": "2(5 + 4) = 18 ✓",
          "explanation": "Check the solution."
        }
      ],
      "process_teks_tags": [
        "A.1B",
        "A.1D",
        "A.1G"
      ]
    },
