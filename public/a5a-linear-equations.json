  "concept_cards": [
    {
      "id": "A5A-C01",
      "title": "Keep the equation balanced",
      "content": "An equation is a balance. Whatever operation you perform on one side must also be performed on the other side."
    },
    {
      "id": "A5A-C02",
      "title": "Use inverse operations",
      "content": "Undo addition with subtraction, multiplication with division, and simplify both sides before isolating the variable."
    },
    {
      "id": "A5A-C03",
      "title": "Distribute to every term",
      "content": "For a(b + c), multiply a by both b and c. Example: 3(x + 2) = 3x + 6."
    },
    {
      "id": "A5A-C04",
      "title": "Recognize special cases",
      "content": "A true statement such as 6 = 6 means infinitely many solutions. A false statement such as 8 = -2 means no solution."
    }
  ],
