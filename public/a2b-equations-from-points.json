{
  "module_id":"alg1-a2b-equations-from-points","version":"1.0.0-private-qa","course":"Algebra 1","teks":["A.2B"],"title":"Write Lines from Points and Slope",
  "student_objective":"I can write linear equations in slope-intercept, point-slope, and standard form from points and slope information.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A2B-D01","A2B-D02"],"guided_item_ids":["A2B-G01","A2B-G02","A2B-G03"],"independent_item_ids":["A2B-P01","A2B-P02","A2B-P03"],"mastery_item_ids":["A2B-M01","A2B-M02","A2B-M03","A2B-M04","A2B-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Slope and substitution readiness"},{"step":2,"type":"concept","label":"Point plus slope determines a line"},{"step":3,"type":"worked_examples","label":"Watch Tolux build equations"},{"step":4,"type":"guided_practice","label":"Write equations with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A2B-C01","title":"Slope-intercept form","content":"y=mx+b. If you know m and one point, substitute the point to solve for b."},
    {"id":"A2B-C02","title":"Point-slope form","content":"y-y₁=m(x-x₁). This form uses a known point (x₁,y₁) and the slope directly."},
    {"id":"A2B-C03","title":"Slope from two points","content":"m=(y₂-y₁)/(x₂-x₁). Subtract in the same order in the numerator and denominator."},
    {"id":"A2B-C04","title":"Standard form","content":"Ax+By=C is another equivalent form. Move x- and y-terms to one side and simplify integer coefficients when possible."},
    {"id":"A2B-C05","title":"Visual slope triangle","content":"Slope is rise/run: vertical change divided by horizontal change between two points on the line."}
  ],
  "misconception_routes":{
    "slope_formula":{"route":"slope","error_code":"LINE-SLOPE","teacher_signal":"Student reverses one subtraction but not the other."},
    "find_intercept":{"route":"intercept","error_code":"LINE-B","teacher_signal":"Student substitutes the point incorrectly when solving for b."},
    "point_slope_sign":{"route":"point-slope","error_code":"LINE-PS","teacher_signal":"Student misses the subtraction signs in point-slope form."}
  },
  "items":[
    {"id":"A2B-D01","type":"diagnostic","difficulty":"Foundational","prompt":"Find the slope through (1,3) and (4,9).","answer_key":"2","accepted_answers":["2","m=2"],"diagnostic_tag":"slope_formula","tutor_behavior":"Use m=(y₂-y₁)/(x₂-x₁) in the same subtraction order.","hint_steps":["Rise=9-3=6.","Run=4-1=3.","m=6/3=2."],"solution_steps":[{"equation":"m=(9-3)/(4-1)","explanation":"Use the slope formula."},{"equation":"m=6/3=2","explanation":"Simplify the ratio."}]},
    {"id":"A2B-D02","type":"diagnostic","difficulty":"Foundational","prompt":"The line y=3x+b passes through (2,11). Find b.","answer_key":"5","accepted_answers":["5","b=5"],"diagnostic_tag":"find_intercept","tutor_behavior":"Substitute x=2 and y=11.","hint_steps":["11=3(2)+b.","11=6+b.","b=5."],"solution_steps":[{"equation":"11=3(2)+b","explanation":"Substitute the point."},{"equation":"b=5","explanation":"Subtract 6 from both sides."}]},
    {"id":"A2B-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Write a slope-intercept equation of the line with slope 2 through (3,7).","answer_key":"y=2x+1","accepted_answers":["y=2x+1","2x-y=-1","-2x+y=1"],"diagnostic_tag":"find_intercept","tutor_behavior":"Use y=mx+b and solve for b with the point.","hint_steps":["Start y=2x+b.","Substitute (3,7): 7=6+b.","b=1, so y=2x+1."],"solution_steps":[{"equation":"7=2(3)+b","explanation":"Substitute the point into y=mx+b."},{"equation":"b=1","explanation":"Solve for the intercept."},{"equation":"y=2x+1","explanation":"Write the completed equation."}]},
    {"id":"A2B-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Write a point-slope equation with slope -3 through (4,5).","answer_key":"y-5=-3(x-4)","accepted_answers":["y-5=-3(x-4)","y=-3x+17","3x+y=17"],"diagnostic_tag":"point_slope_sign","tutor_behavior":"Use y-y₁=m(x-x₁) exactly.","hint_steps":["x₁=4 and y₁=5.","Substitute into y-y₁=m(x-x₁).","y-5=-3(x-4)."],"solution_steps":[{"equation":"y-y₁=m(x-x₁)","explanation":"Start with point-slope form."},{"equation":"y-5=-3(x-4)","explanation":"Substitute the slope and point."}]},
    {"id":"A2B-L03","type":"worked_example","difficulty":"Grade-level","prompt":"Write an equation of the line through (-1,4) and (3,12).","answer_key":"y=2x+6","accepted_answers":["y=2x+6","2x-y=-6","-2x+y=6","y-4=2(x+1)"],"diagnostic_tag":"slope_formula","tutor_behavior":"Find the slope first, then use either point.","hint_steps":["m=(12-4)/(3-(-1))=8/4=2.","Use (-1,4): 4=2(-1)+b.","b=6, so y=2x+6."],"solution_steps":[{"equation":"m=(12-4)/(3+1)=2","explanation":"Find the slope from the two points."},{"equation":"4=2(-1)+b","explanation":"Use one point to find b."},{"equation":"y=2x+6","explanation":"Write slope-intercept form."}]},
    {"id":"A2B-G01","type":"guided_practice","difficulty":"Foundational","prompt":"Write a slope-intercept equation with slope 4 through (1,6).","answer_key":"y=4x+2","accepted_answers":["y=4x+2","4x-y=-2","-4x+y=2"],"diagnostic_tag":"find_intercept","tutor_behavior":"Substitute the point into y=4x+b.","hint_steps":["6=4(1)+b.","b=2.","y=4x+2."],"solution_steps":[{"equation":"6=4+b","explanation":"Substitute the point."},{"equation":"b=2","explanation":"Find the intercept."},{"equation":"y=4x+2","explanation":"Write the equation."}]},
    {"id":"A2B-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Write a point-slope equation with slope 1/2 through (-2,3).","answer_key":"y-3=(1/2)(x+2)","accepted_answers":["y-3=(1/2)(x+2)","y=0.5x+4","y=(1/2)x+4","x-2y=-8"],"diagnostic_tag":"point_slope_sign","tutor_behavior":"Subtracting a negative x-coordinate creates x+2.","hint_steps":["Use x₁=-2 and y₁=3.","x-(-2)=x+2.","y-3=(1/2)(x+2)."],"solution_steps":[{"equation":"y-3=(1/2)(x-(-2))","explanation":"Substitute the point and slope."},{"equation":"y-3=(1/2)(x+2)","explanation":"Simplify the double negative."}]},
    {"id":"A2B-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Write an equation through (0,-5) and (2,1).","answer_key":"y=3x-5","accepted_answers":["y=3x-5","3x-y=5","y+5=3x"],"diagnostic_tag":"slope_formula","tutor_behavior":"Use the two points to find slope, then notice the y-intercept point.","hint_steps":["m=(1-(-5))/(2-0)=6/2=3.","The point (0,-5) gives b=-5.","y=3x-5."],"solution_steps":[{"equation":"m=6/2=3","explanation":"Find the slope."},{"equation":"b=-5","explanation":"At x=0, y is the intercept."},{"equation":"y=3x-5","explanation":"Write slope-intercept form."}]},
    {"id":"A2B-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Write a slope-intercept equation with slope -2 through (5,-1).","answer_key":"y=-2x+9","accepted_answers":["y=-2x+9","2x+y=9","y+1=-2(x-5)"],"diagnostic_tag":"find_intercept","tutor_behavior":"Substitute the point carefully with the negative slope.","hint_steps":["-1=-2(5)+b.","-1=-10+b, so b=9.","y=-2x+9."],"solution_steps":[{"equation":"-1=-10+b","explanation":"Substitute the point."},{"equation":"b=9","explanation":"Solve for b."},{"equation":"y=-2x+9","explanation":"Write the equation."}]},
    {"id":"A2B-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Write an equation through (2,5) and (6,1).","answer_key":"y=-x+7","accepted_answers":["y=-x+7","x+y=7","y-5=-(x-2)"],"diagnostic_tag":"slope_formula","tutor_behavior":"Find slope -1, then use either point.","hint_steps":["m=(1-5)/(6-2)=-4/4=-1.","5=-2+b.","b=7, so y=-x+7."],"solution_steps":[{"equation":"m=-1","explanation":"Find the slope."},{"equation":"5=-2+b","explanation":"Use point (2,5)."},{"equation":"y=-x+7","explanation":"Write the equation."}]},
    {"id":"A2B-P03","type":"independent_practice","difficulty":"Challenging","prompt":"Write a standard-form equation of the line with slope 3/4 through (8,-2).","answer_key":"3x-4y=32","accepted_answers":["3x-4y=32","-3x+4y=-32","y+2=(3/4)(x-8)","y=(3/4)x-8"],"diagnostic_tag":"point_slope_sign","tutor_behavior":"Use point-slope form, clear the denominator, then rearrange.","hint_steps":["y+2=(3/4)(x-8).","4y+8=3x-24.","3x-4y=32."],"solution_steps":[{"equation":"y+2=(3/4)(x-8)","explanation":"Write point-slope form."},{"equation":"4y+8=3x-24","explanation":"Multiply by 4."},{"equation":"3x-4y=32","explanation":"Rearrange to standard form."}]},
    {"id":"A2B-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Write a slope-intercept equation with slope 5 through (2,13).","answer_key":"y=5x+3","accepted_answers":["y=5x+3","5x-y=-3","y-13=5(x-2)"],"diagnostic_tag":"find_intercept","tutor_behavior":"Find b by substitution.","hint_steps":["13=10+b.","b=3.","y=5x+3."],"solution_steps":[{"equation":"13=5(2)+b","explanation":"Substitute the point."},{"equation":"y=5x+3","explanation":"Write the equation."}]},
    {"id":"A2B-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Write a point-slope equation with slope -1/3 through (6,4).","answer_key":"y-4=(-1/3)(x-6)","accepted_answers":["y-4=(-1/3)(x-6)","y=-(1/3)x+6","x+3y=18"],"diagnostic_tag":"point_slope_sign","tutor_behavior":"Insert the point directly into point-slope form.","hint_steps":["x₁=6, y₁=4.","Use y-y₁=m(x-x₁).","y-4=(-1/3)(x-6)."],"solution_steps":[{"equation":"y-4=(-1/3)(x-6)","explanation":"Substitute the slope and point."}]},
    {"id":"A2B-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Write an equation through (-3,2) and (1,10).","answer_key":"y=2x+8","accepted_answers":["y=2x+8","2x-y=-8","y-2=2(x+3)"],"diagnostic_tag":"slope_formula","tutor_behavior":"Find slope 2, then find b.","hint_steps":["m=(10-2)/(1-(-3))=8/4=2.","2=2(-3)+b.","b=8, so y=2x+8."],"solution_steps":[{"equation":"m=2","explanation":"Find slope."},{"equation":"b=8","explanation":"Substitute one point."},{"equation":"y=2x+8","explanation":"Write the equation."}]},
    {"id":"A2B-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"A line has slope 0 and passes through (4,-7). Write its equation.","answer_key":"y=-7","accepted_answers":["y=-7","y+7=0"],"diagnostic_tag":"find_intercept","tutor_behavior":"Slope 0 means a horizontal line with constant y-value.","hint_steps":["A horizontal line has slope 0.","Every point has y=-7.","The equation is y=-7."],"solution_steps":[{"equation":"m=0","explanation":"The line is horizontal."},{"equation":"y=-7","explanation":"The y-value stays constant."}]},
    {"id":"A2B-M05","type":"mastery_check","difficulty":"Challenging","prompt":"Write a standard-form equation through (1,-2) and (5,4).","answer_key":"3x-2y=7","accepted_answers":["3x-2y=7","-3x+2y=-7","y+2=(3/2)(x-1)","y=(3/2)x-7/2"],"diagnostic_tag":"slope_formula","tutor_behavior":"Find slope 3/2, use point-slope form, clear the denominator, then rearrange.","hint_steps":["m=(4-(-2))/(5-1)=6/4=3/2.","y+2=(3/2)(x-1).","2y+4=3x-3, so 3x-2y=7."],"solution_steps":[{"equation":"m=3/2","explanation":"Find the slope."},{"equation":"y+2=(3/2)(x-1)","explanation":"Use point-slope form."},{"equation":"2y+4=3x-3","explanation":"Clear the denominator."},{"equation":"3x-2y=7","explanation":"Rearrange to standard form."}]}
  ]
}