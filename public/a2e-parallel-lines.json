{
  "module_id":"alg1-a2e-parallel-lines","version":"1.0.0-private-qa","course":"Algebra 1","teks":["A.2E"],"title":"Equations of Parallel Lines",
  "student_objective":"I can write the equation of a line through a point and parallel to a given line.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A2E-D01","A2E-D02"],"guided_item_ids":["A2E-G01","A2E-G02","A2E-G03"],"independent_item_ids":["A2E-P01","A2E-P02","A2E-P03"],"mastery_item_ids":["A2E-M01","A2E-M02","A2E-M03","A2E-M04","A2E-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Slope readiness"},{"step":2,"type":"concept","label":"Parallel means same slope"},{"step":3,"type":"worked_examples","label":"Watch Tolux build parallel lines"},{"step":4,"type":"guided_practice","label":"Write parallel lines with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A2E-C01","title":"Same slope","content":"Distinct parallel nonvertical lines have the same slope and different y-intercepts."},
    {"id":"A2E-C02","title":"Read the given slope","content":"If the given line is not in y=mx+b form, rewrite it or identify its slope before doing anything else."},
    {"id":"A2E-C03","title":"Use the required point","content":"Keep the parallel slope, substitute the required point into y=mx+b, and solve for the new intercept."},
    {"id":"A2E-C04","title":"Verify","content":"The new line must have the same slope as the original and must pass through the requested point."}
  ],
  "misconception_routes":{
    "parallel_slope":{"route":"slope","error_code":"PAR-SLOPE","teacher_signal":"Student changes the slope instead of preserving it."},
    "new_intercept":{"route":"intercept","error_code":"PAR-B","teacher_signal":"Student keeps the original intercept instead of using the new point."},
    "rewrite_equation":{"route":"form","error_code":"PAR-FORM","teacher_signal":"Student misreads slope from standard form."}
  },
  "items":[
    {"id":"A2E-D01","type":"diagnostic","difficulty":"Foundational","prompt":"What slope is parallel to a line with slope 3?","answer_key":"3","accepted_answers":["3","m=3"],"diagnostic_tag":"parallel_slope","tutor_behavior":"Parallel lines keep the same slope.","hint_steps":["Parallel lines point in the same direction.","That means their slopes are equal.","The parallel slope is 3."],"solution_steps":[{"equation":"m_parallel=m_given","explanation":"Parallel lines have equal slopes."},{"equation":"m=3","explanation":"Keep the given slope."}]},
    {"id":"A2E-D02","type":"diagnostic","difficulty":"Foundational","prompt":"In 2x+y=7, what is the slope?","answer_key":"-2","accepted_answers":["-2","m=-2"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Solve for y to identify slope.","hint_steps":["Subtract 2x from both sides.","y=-2x+7.","The slope is -2."],"solution_steps":[{"equation":"y=-2x+7","explanation":"Rewrite in slope-intercept form."},{"equation":"m=-2","explanation":"Read the x coefficient."}]},
    {"id":"A2E-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Write the line through (2,5) parallel to y=3x-4.","answer_key":"y=3x-1","accepted_answers":["y=3x-1","3x-y=1"],"diagnostic_tag":"new_intercept","tutor_behavior":"Keep slope 3 and solve for a new intercept.","hint_steps":["Parallel slope m=3.","Use 5=3(2)+b to find b.","b=-1, so y=3x-1."],"solution_steps":[{"equation":"m=3","explanation":"Use the same slope."},{"equation":"5=3(2)+b → b=-1","explanation":"Substitute the required point."},{"equation":"y=3x-1","explanation":"Write the new line."}]},
    {"id":"A2E-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Write the line through (-1,4) parallel to y=-2x+7.","answer_key":"y=-2x+2","accepted_answers":["y=-2x+2","2x+y=2"],"diagnostic_tag":"new_intercept","tutor_behavior":"Preserve slope -2.","hint_steps":["m=-2.","4=-2(-1)+b.","b=2, so y=-2x+2."],"solution_steps":[{"equation":"m=-2","explanation":"Parallel lines use equal slope."},{"equation":"4=2+b → b=2","explanation":"Use the point."},{"equation":"y=-2x+2","explanation":"Write the equation."}]},
    {"id":"A2E-L03","type":"worked_example","difficulty":"Grade-level","prompt":"Write the line through (3,-2) parallel to 4x-2y=10.","answer_key":"y=2x-8","accepted_answers":["y=2x-8","2x-y=8","4x-2y=16"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Rewrite the given line first to find its slope.","hint_steps":["4x-2y=10 becomes y=2x-5.","Parallel slope is 2.","Use -2=2(3)+b to get b=-8, so y=2x-8."],"solution_steps":[{"equation":"4x-2y=10 → y=2x-5","explanation":"Find the original slope."},{"equation":"m=2","explanation":"Keep that slope."},{"equation":"-2=6+b → b=-8","explanation":"Use the required point."},{"equation":"y=2x-8","explanation":"Write the new line."}]},
    {"id":"A2E-G01","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the line through (1,7) parallel to y=4x+9.","answer_key":"y=4x+3","accepted_answers":["y=4x+3","4x-y=-3"],"diagnostic_tag":"new_intercept","tutor_behavior":"Same slope, new intercept.","hint_steps":["m=4.","7=4(1)+b, so b=3.","y=4x+3."],"solution_steps":[{"equation":"m=4","explanation":"Keep slope."},{"equation":"b=3","explanation":"Use the point."},{"equation":"y=4x+3","explanation":"Write the line."}]},
    {"id":"A2E-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the line through (0,-6) parallel to y=(1/2)x+4.","answer_key":"y=(1/2)x-6","accepted_answers":["y=(1/2)x-6","y=0.5x-6","x-2y=12"],"diagnostic_tag":"parallel_slope","tutor_behavior":"Keep fractional slope 1/2.","hint_steps":["Parallel slope is 1/2.","The point x=0 gives b=-6 directly.","y=(1/2)x-6."],"solution_steps":[{"equation":"m=1/2","explanation":"Keep the slope."},{"equation":"b=-6","explanation":"Read intercept from the point."},{"equation":"y=(1/2)x-6","explanation":"Write the equation."}]},
    {"id":"A2E-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the line through (4,1) parallel to 3x+y=2.","answer_key":"y=-3x+13","accepted_answers":["y=-3x+13","3x+y=13"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Convert standard form to slope-intercept form first.","hint_steps":["3x+y=2 gives y=-3x+2.","Parallel slope is -3.","1=-3(4)+b gives b=13, so y=-3x+13."],"solution_steps":[{"equation":"y=-3x+2","explanation":"Find given slope -3."},{"equation":"1=-12+b → b=13","explanation":"Use the required point."},{"equation":"y=-3x+13","explanation":"Write the parallel line."}]},
    {"id":"A2E-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the line through (-2,5) parallel to y=x-8.","answer_key":"y=x+7","accepted_answers":["y=x+7","x-y=-7"],"diagnostic_tag":"new_intercept","tutor_behavior":"Use slope 1.","hint_steps":["m=1.","5=-2+b, so b=7.","y=x+7."],"solution_steps":[{"equation":"m=1","explanation":"Keep slope."},{"equation":"b=7","explanation":"Use point."},{"equation":"y=x+7","explanation":"Write equation."}]},
    {"id":"A2E-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the line through (6,-1) parallel to y=(-3/2)x+2.","answer_key":"y=(-3/2)x+8","accepted_answers":["y=(-3/2)x+8","y=-1.5x+8","3x+2y=16"],"diagnostic_tag":"parallel_slope","tutor_behavior":"Keep the negative fractional slope.","hint_steps":["m=-3/2.","-1=(-3/2)(6)+b=-9+b.","b=8, so y=(-3/2)x+8."],"solution_steps":[{"equation":"m=-3/2","explanation":"Keep slope."},{"equation":"-1=-9+b → b=8","explanation":"Find intercept."},{"equation":"y=(-3/2)x+8","explanation":"Write line."}]},
    {"id":"A2E-P03","type":"independent_practice","difficulty":"Grade-level","prompt":"Write the line through (2,0) parallel to 5x-y=9.","answer_key":"y=5x-10","accepted_answers":["y=5x-10","5x-y=10"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Rewrite first, then preserve slope.","hint_steps":["5x-y=9 gives y=5x-9.","m=5.","0=5(2)+b gives b=-10, so y=5x-10."],"solution_steps":[{"equation":"y=5x-9","explanation":"Find slope 5."},{"equation":"b=-10","explanation":"Use the point."},{"equation":"y=5x-10","explanation":"Write line."}]},
    {"id":"A2E-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (3,10) parallel to y=2x-5.","answer_key":"y=2x+4","accepted_answers":["y=2x+4","2x-y=-4"],"diagnostic_tag":"new_intercept","tutor_behavior":"Same slope 2.","hint_steps":["m=2.","10=6+b gives b=4.","y=2x+4."],"solution_steps":[{"equation":"m=2,b=4","explanation":"Preserve slope and use point."},{"equation":"y=2x+4","explanation":"Write equation."}]},
    {"id":"A2E-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (-4,1) parallel to y=-x+6.","answer_key":"y=-x-3","accepted_answers":["y=-x-3","x+y=-3"],"diagnostic_tag":"parallel_slope","tutor_behavior":"Slope remains -1.","hint_steps":["m=-1.","1=4+b gives b=-3.","y=-x-3."],"solution_steps":[{"equation":"m=-1,b=-3","explanation":"Find new intercept."},{"equation":"y=-x-3","explanation":"Write equation."}]},
    {"id":"A2E-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (1,-5) parallel to 2x-4y=12.","answer_key":"y=(1/2)x-5.5","accepted_answers":["y=(1/2)x-5.5","y=0.5x-5.5","x-2y=11"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Rewrite standard form to identify slope 1/2.","hint_steps":["2x-4y=12 gives y=(1/2)x-3.","Parallel slope is 1/2.","-5=1/2+b gives b=-5.5, so y=(1/2)x-5.5."],"solution_steps":[{"equation":"y=(1/2)x-3","explanation":"Find slope."},{"equation":"-5=1/2+b → b=-5.5","explanation":"Use point."},{"equation":"y=(1/2)x-5.5","explanation":"Write equation."}]},
    {"id":"A2E-M04","type":"mastery_check","difficulty":"Challenging","prompt":"A line parallel to y=(2/3)x-1 passes through (9,10). Write its equation.","answer_key":"y=(2/3)x+4","accepted_answers":["y=(2/3)x+4","2x-3y=-12"],"diagnostic_tag":"parallel_slope","tutor_behavior":"Keep slope 2/3 and solve for b.","hint_steps":["m=2/3.","10=(2/3)(9)+b=6+b.","b=4, so y=(2/3)x+4."],"solution_steps":[{"equation":"10=6+b → b=4","explanation":"Use point with same slope."},{"equation":"y=(2/3)x+4","explanation":"Write equation."}]},
    {"id":"A2E-M05","type":"mastery_check","difficulty":"Grade-level","prompt":"Write the line through (0,8) parallel to 4x+y=1.","answer_key":"y=-4x+8","accepted_answers":["y=-4x+8","4x+y=8"],"diagnostic_tag":"rewrite_equation","tutor_behavior":"Find slope -4 and use point x=0.","hint_steps":["4x+y=1 gives y=-4x+1.","m=-4.","b=8, so y=-4x+8."],"solution_steps":[{"equation":"m=-4","explanation":"Read slope after rewriting."},{"equation":"b=8","explanation":"Use the point."},{"equation":"y=-4x+8","explanation":"Write line."}]}
  ]
}