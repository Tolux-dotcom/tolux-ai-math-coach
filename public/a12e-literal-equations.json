{
  "module_id":"alg1-a12e-literal-equations","version":"1.0.0-private-qa","course":"Algebra 1","teks":["A.12E"],"title":"Solve Literal Equations",
  "student_objective":"I can rearrange mathematical and scientific formulas to solve for a specified variable.",
  "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":false,"recheck_after_remediation_items":2},
  "lesson_settings":{"diagnostic_item_ids":["A12E-D01","A12E-D02"],"guided_item_ids":["A12E-G01","A12E-G02","A12E-G03"],"independent_item_ids":["A12E-P01","A12E-P02","A12E-P03"],"mastery_item_ids":["A12E-M01","A12E-M02","A12E-M03","A12E-M04","A12E-M05"]},
  "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Inverse-operation readiness"},{"step":2,"type":"concept","label":"Move everything except the target"},{"step":3,"type":"worked_examples","label":"Watch Tolux rearrange formulas"},{"step":4,"type":"guided_practice","label":"Rearrange with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
  "concept_cards":[
    {"id":"A12E-C01","title":"Target variable","content":"Circle the variable you must isolate. Treat every other letter as a known number."},
    {"id":"A12E-C02","title":"Undo in reverse order","content":"Use inverse operations on both sides. Addition is undone by subtraction; multiplication is undone by division."},
    {"id":"A12E-C03","title":"Keep formulas balanced","content":"Whatever operation you perform on one side of the equation must also be performed on the other side."},
    {"id":"A12E-C04","title":"Equivalent forms","content":"Different-looking formulas can be equivalent. For example, y=(A-b)/m and y=(A/m)-(b/m) represent the same result when m≠0."}
  ],
  "misconception_routes":{
    "inverse_operations":{"route":"inverse","error_code":"LIT-INVERSE","teacher_signal":"Student applies the wrong inverse operation."},
    "distribute_divide":{"route":"division","error_code":"LIT-DIV","teacher_signal":"Student divides only one term instead of the full expression."},
    "target_variable":{"route":"target","error_code":"LIT-TARGET","teacher_signal":"Student isolates the wrong variable."}
  },
  "items":[
    {"id":"A12E-D01","type":"diagnostic","difficulty":"Foundational","prompt":"Solve a+b=c for a.","answer_key":"a=c-b","accepted_answers":["a=c-b","c-b=a"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Undo +b by subtracting b from both sides.","hint_steps":["The target is a.","Subtract b from both sides.","a=c-b."],"solution_steps":[{"equation":"a+b-b=c-b","explanation":"Subtract b from both sides."},{"equation":"a=c-b","explanation":"a is isolated."}]},
    {"id":"A12E-D02","type":"diagnostic","difficulty":"Foundational","prompt":"Solve mx=y for x.","answer_key":"x=y/m","accepted_answers":["x=y/m","y/m=x"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Undo multiplication by m using division.","hint_steps":["x is multiplied by m.","Divide both sides by m.","x=y/m."],"solution_steps":[{"equation":"mx/m=y/m","explanation":"Divide both sides by m."},{"equation":"x=y/m","explanation":"x is isolated, assuming m≠0."}]},
    {"id":"A12E-L01","type":"worked_example","difficulty":"Grade-level","prompt":"Solve y=mx+b for x.","answer_key":"x=(y-b)/m","accepted_answers":["x=(y-b)/m","(y-b)/m=x"],"diagnostic_tag":"target_variable","tutor_behavior":"Remove b first, then divide by m.","hint_steps":["Subtract b from both sides.","Now mx=y-b.","Divide by m: x=(y-b)/m."],"solution_steps":[{"equation":"y-b=mx","explanation":"Subtract b from both sides."},{"equation":"(y-b)/m=x","explanation":"Divide both sides by m."},{"equation":"x=(y-b)/m","explanation":"Write the target variable first."}]},
    {"id":"A12E-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Solve A=lw for w.","answer_key":"w=A/l","accepted_answers":["w=A/l","A/l=w"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Divide by l.","hint_steps":["w is multiplied by l.","Divide both sides by l.","w=A/l."],"solution_steps":[{"equation":"A/l=lw/l","explanation":"Divide both sides by l."},{"equation":"w=A/l","explanation":"w is isolated."}]},
    {"id":"A12E-L03","type":"worked_example","difficulty":"Challenging","prompt":"Solve P=2l+2w for l.","answer_key":"l=(P-2w)/2","accepted_answers":["l=(P-2w)/2","l=P/2-w","(P-2w)/2=l"],"diagnostic_tag":"distribute_divide","tutor_behavior":"Remove the 2w term before dividing by 2.","hint_steps":["Subtract 2w from both sides.","P-2w=2l.","Divide the entire left side by 2: l=(P-2w)/2."],"solution_steps":[{"equation":"P-2w=2l","explanation":"Subtract 2w from both sides."},{"equation":"(P-2w)/2=l","explanation":"Divide both sides by 2."},{"equation":"l=(P-2w)/2","explanation":"l is isolated."}]},
    {"id":"A12E-G01","type":"guided_practice","difficulty":"Foundational","prompt":"Solve d=rt for t.","answer_key":"t=d/r","accepted_answers":["t=d/r","d/r=t"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Undo multiplication by r.","hint_steps":["t is multiplied by r.","Divide both sides by r.","t=d/r."],"solution_steps":[{"equation":"d/r=rt/r","explanation":"Divide both sides by r."},{"equation":"t=d/r","explanation":"t is isolated."}]},
    {"id":"A12E-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Solve C=5(F-32)/9 for F.","answer_key":"F=9C/5+32","accepted_answers":["F=9C/5+32","F=(9C/5)+32","9C/5+32=F"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Undo division by 9, multiplication by 5, then subtraction of 32 in reverse order.","hint_steps":["Multiply both sides by 9.","Divide by 5 to get 9C/5=F-32.","Add 32: F=9C/5+32."],"solution_steps":[{"equation":"9C=5(F-32)","explanation":"Multiply both sides by 9."},{"equation":"9C/5=F-32","explanation":"Divide both sides by 5."},{"equation":"F=9C/5+32","explanation":"Add 32 to both sides."}]},
    {"id":"A12E-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Solve V=πr²h for h.","answer_key":"h=V/(πr²)","accepted_answers":["h=V/(πr²)","h=V/(pi*r^2)","V/(πr²)=h","V/(pi*r^2)=h"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Divide by the entire factor πr².","hint_steps":["h is multiplied by πr².","Divide both sides by πr².","h=V/(πr²)."],"solution_steps":[{"equation":"V/(πr²)=h","explanation":"Divide both sides by the complete factor πr²."},{"equation":"h=V/(πr²)","explanation":"h is isolated."}]},
    {"id":"A12E-P01","type":"independent_practice","difficulty":"Grade-level","prompt":"Solve A=(1/2)bh for h.","answer_key":"h=2A/b","accepted_answers":["h=2A/b","2A/b=h"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Undo the factor 1/2 and then divide by b.","hint_steps":["Multiply both sides by 2.","2A=bh.","Divide by b: h=2A/b."],"solution_steps":[{"equation":"2A=bh","explanation":"Multiply both sides by 2."},{"equation":"h=2A/b","explanation":"Divide both sides by b."}]},
    {"id":"A12E-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Solve I=Prt for r.","answer_key":"r=I/(Pt)","accepted_answers":["r=I/(Pt)","r=I/(P*t)","I/(Pt)=r","I/(P*t)=r"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Divide by the entire product Pt.","hint_steps":["r is multiplied by P and t.","Divide both sides by Pt.","r=I/(Pt)."],"solution_steps":[{"equation":"I/(Pt)=r","explanation":"Divide both sides by Pt."},{"equation":"r=I/(Pt)","explanation":"r is isolated."}]},
    {"id":"A12E-P03","type":"independent_practice","difficulty":"Challenging","prompt":"Solve y=(x+a)/b for x.","answer_key":"x=by-a","accepted_answers":["x=by-a","by-a=x"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Undo division by b first, then subtract a.","hint_steps":["Multiply both sides by b.","by=x+a.","Subtract a: x=by-a."],"solution_steps":[{"equation":"by=x+a","explanation":"Multiply both sides by b."},{"equation":"by-a=x","explanation":"Subtract a from both sides."},{"equation":"x=by-a","explanation":"x is isolated."}]},
    {"id":"A12E-M01","type":"mastery_check","difficulty":"Grade-level","prompt":"Solve F=ma for a.","answer_key":"a=F/m","accepted_answers":["a=F/m","F/m=a"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Divide by m.","hint_steps":["a is multiplied by m.","Divide by m.","a=F/m."],"solution_steps":[{"equation":"a=F/m","explanation":"Divide both sides by m."}]},
    {"id":"A12E-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Solve y=kx+b for k.","answer_key":"k=(y-b)/x","accepted_answers":["k=(y-b)/x","(y-b)/x=k"],"diagnostic_tag":"target_variable","tutor_behavior":"Subtract b, then divide by x.","hint_steps":["Subtract b.","y-b=kx.","Divide by x: k=(y-b)/x."],"solution_steps":[{"equation":"y-b=kx","explanation":"Subtract b from both sides."},{"equation":"k=(y-b)/x","explanation":"Divide by x."}]},
    {"id":"A12E-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Solve A=πr² for r, assuming r≥0.","answer_key":"r=√(A/π)","accepted_answers":["r=√(A/π)","r=sqrt(A/pi)","sqrt(A/pi)=r"],"diagnostic_tag":"inverse_operations","tutor_behavior":"Divide by π, then take the nonnegative square root.","hint_steps":["Divide by π: A/π=r².","Take the square root of both sides.","r=√(A/π)."],"solution_steps":[{"equation":"A/π=r²","explanation":"Divide both sides by π."},{"equation":"r=√(A/π)","explanation":"Use the nonnegative square root because r≥0."}]},
    {"id":"A12E-M04","type":"mastery_check","difficulty":"Grade-level","prompt":"Solve S=2πr²+2πrh for h.","answer_key":"h=(S-2πr²)/(2πr)","accepted_answers":["h=(S-2πr²)/(2πr)","h=(S-2*pi*r^2)/(2*pi*r)","(S-2πr²)/(2πr)=h"],"diagnostic_tag":"distribute_divide","tutor_behavior":"Subtract the term without h, then divide by the full coefficient of h.","hint_steps":["Subtract 2πr² from both sides.","S-2πr²=2πrh.","Divide by 2πr: h=(S-2πr²)/(2πr)."],"solution_steps":[{"equation":"S-2πr²=2πrh","explanation":"Subtract 2πr²."},{"equation":"h=(S-2πr²)/(2πr)","explanation":"Divide by the entire coefficient 2πr."}]},
    {"id":"A12E-M05","type":"mastery_check","difficulty":"Challenging","prompt":"Solve 1/f=1/p+1/q for q.","answer_key":"q=fp/(p-f)","accepted_answers":["q=fp/(p-f)","q=(f*p)/(p-f)","fp/(p-f)=q"],"diagnostic_tag":"distribute_divide","tutor_behavior":"Isolate 1/q first, combine the other fractions, then take the reciprocal.","hint_steps":["1/q=1/f-1/p.","1/q=(p-f)/(fp).","Take reciprocals: q=fp/(p-f)."],"solution_steps":[{"equation":"1/q=1/f-1/p","explanation":"Subtract 1/p from both sides."},{"equation":"1/q=(p-f)/(fp)","explanation":"Combine the fractions."},{"equation":"q=fp/(p-f)","explanation":"Take the reciprocal of both sides."}]}
  ]
}