{
 "module_id":"alg1-a6b-write-quadratics-from-vertex","version":"1.0.0-depth-qa","course":"Algebra 1","teks":["A.6B"],"title":"Write Quadratics from a Vertex and Point",
 "student_objective":"I can use a vertex and another point to write a quadratic in vertex form, solve for a, and convert the function to standard form.",
 "teacher_objective":"Diagnose vertex-sign errors, incorrect point substitution, failure to square the horizontal distance, solve-for-a errors, and expansion errors.",
 "mastery_policy":{"threshold_percent":80,"minimum_mastery_items":5,"critical_misconceptions_allowed":0,"requires_explanation_item":true,"recheck_after_remediation_items":2},
 "lesson_settings":{"diagnostic_item_ids":["A6B-D01","A6B-D02","A6B-D03"],"guided_item_ids":["A6B-G01","A6B-G02","A6B-G03"],"independent_item_ids":["A6B-P01","A6B-P02","A6B-P03","A6B-P04"],"mastery_item_ids":["A6B-M01","A6B-M02","A6B-M03","A6B-M04","A6B-M05"],"assessed_items_in_core_lesson":15},
 "lesson_flow":[{"step":1,"type":"prerequisite_diagnostic","label":"Quick readiness check"},{"step":2,"type":"concept","label":"Vertex form and point substitution"},{"step":3,"type":"worked_examples","label":"Watch Tolux build"},{"step":4,"type":"guided_practice","label":"Build with Tolux"},{"step":5,"type":"independent_practice","label":"Your turn"},{"step":6,"type":"mastery_check","label":"Check mastery"},{"step":7,"type":"remediation_or_complete","label":"Next best step"}],
 "concept_cards":[{"id":"A6B-C01","title":"Vertex form stores the vertex","content":"In y=a(x-h)^2+k, the vertex is (h,k). The sign inside the parentheses is opposite the vertex x-coordinate."},{"id":"A6B-C02","title":"Use the other point to find a","content":"Substitute the point's x and y values into y=a(x-h)^2+k, then solve the resulting equation for a."},{"id":"A6B-C03","title":"Square the full horizontal distance","content":"Evaluate (x-h) first and square the complete result before multiplying by a."},{"id":"A6B-C04","title":"Verify both conditions","content":"The completed function must have the stated vertex and produce the stated y-value at the second point."},{"id":"A6B-C05","title":"Convert carefully","content":"Expand (x-h)^2, distribute a, and combine constants to write ax^2+bx+c."}],
 "items":[
  {"id":"A6B-D01","type":"diagnostic","difficulty":"Foundational","prompt":"Write vertex form with vertex (3,-2), leaving a unknown.","answer_key":"y = a(x - 3)^2 - 2","accepted_answers":["y=a(x-3)^2-2"],"diagnostic_tag":"vertex_sign","critical_misconception":true,"tutor_behavior":"Contrast vertex h with the opposite sign inside x-h."},
  {"id":"A6B-D02","type":"diagnostic","difficulty":"Foundational","prompt":"If y=a(x-1)^2+2 passes through (3,10), write the equation used to solve for a.","answer_key":"10 = 4a + 2","accepted_answers":["10=4a+2","10=a(3-1)^2+2"],"diagnostic_tag":"point_substitution","tutor_behavior":"Substitute x=3 and y=10, then square 2."},
  {"id":"A6B-D03","type":"diagnostic","difficulty":"Foundational","prompt":"Solve 12 = 9a + 3 for a.","answer_key":"a = 1","accepted_answers":["a=1","1"],"diagnostic_tag":"solve_for_a","tutor_behavior":"Subtract 3 and divide by 9."},
  {"id":"A6B-L01","type":"worked_example","difficulty":"Foundational","prompt":"Write a quadratic with vertex (1,2) through (3,10).","answer_key":"y = 2(x - 1)^2 + 2","accepted_answers":["y=2(x-1)^2+2"],"diagnostic_tag":"solve_for_a","solution_steps":[{"equation":"y=a(x-1)^2+2","explanation":"Use vertex (1,2)."},{"equation":"10=4a+2","explanation":"Substitute (3,10)."},{"equation":"a=2","explanation":"Solve for a."}],"tutor_behavior":"Verify the vertex and point."},
  {"id":"A6B-L02","type":"worked_example","difficulty":"Grade-level","prompt":"Write a quadratic with vertex (-2,5) through (0,1).","answer_key":"y = -(x + 2)^2 + 5","accepted_answers":["y=-(x+2)^2+5","y=-1(x+2)^2+5"],"diagnostic_tag":"vertex_sign","critical_misconception":true,"solution_steps":[{"equation":"y=a(x+2)^2+5","explanation":"Use h=-2."},{"equation":"1=4a+5","explanation":"Substitute (0,1)."},{"equation":"a=-1","explanation":"Solve."}],"tutor_behavior":"Emphasize x+2 and negative a."},
  {"id":"A6B-L03","type":"worked_example","difficulty":"Grade-level","prompt":"Convert y=2(x-3)^2-1 to standard form.","answer_key":"y = 2x^2 - 12x + 17","accepted_answers":["y=2x^2-12x+17"],"diagnostic_tag":"expand_standard_form","solution_steps":[{"equation":"2(x^2-6x+9)-1","explanation":"Expand the square."},{"equation":"2x^2-12x+18-1","explanation":"Distribute 2."},{"equation":"2x^2-12x+17","explanation":"Combine constants."}],"tutor_behavior":"Check the middle term and constant."},
  {"id":"A6B-G01","type":"guided_practice","difficulty":"Foundational","prompt":"Vertex (2,-1), point (4,7): find a.","answer_key":"a = 2","accepted_answers":["a=2","2"],"diagnostic_tag":"solve_for_a","tutor_behavior":"Build 7=4a-1."},
  {"id":"A6B-G02","type":"guided_practice","difficulty":"Grade-level","prompt":"Write the quadratic with vertex (-1,3) through (1,-5).","answer_key":"y = -2(x + 1)^2 + 3","accepted_answers":["y=-2(x+1)^2+3"],"diagnostic_tag":"vertex_sign","critical_misconception":true,"tutor_behavior":"Form x+1, substitute, and solve."},
  {"id":"A6B-G03","type":"guided_practice","difficulty":"Grade-level","prompt":"Convert y=-(x+2)^2+6 to standard form.","answer_key":"y = -x^2 - 4x + 2","accepted_answers":["y=-x^2-4x+2"],"diagnostic_tag":"expand_standard_form","tutor_behavior":"Distribute the negative across all three terms."},
  {"id":"A6B-P01","type":"independent_practice","difficulty":"Foundational","prompt":"Write a quadratic with vertex (0,1) through (2,9).","answer_key":"y = 2x^2 + 1","accepted_answers":["y=2x^2+1","y=2(x-0)^2+1"],"diagnostic_tag":"solve_for_a","tutor_behavior":"Use the origin-aligned vertex accurately."},
  {"id":"A6B-P02","type":"independent_practice","difficulty":"Grade-level","prompt":"Write a quadratic with vertex (4,-3) through (2,5).","answer_key":"y = 2(x - 4)^2 - 3","accepted_answers":["y=2(x-4)^2-3"],"diagnostic_tag":"point_substitution","tutor_behavior":"Square the horizontal distance -2."},
  {"id":"A6B-P03","type":"independent_practice","difficulty":"Grade-level","prompt":"Write a quadratic with vertex (-3,-2) through (-1,-10).","answer_key":"y = -2(x + 3)^2 - 2","accepted_answers":["y=-2(x+3)^2-2"],"diagnostic_tag":"vertex_sign","critical_misconception":true,"tutor_behavior":"Use x+3 and solve for a negative scale."},
  {"id":"A6B-P04","type":"independent_practice","difficulty":"Challenging","prompt":"Convert y=3(x+1)^2-8 to standard form.","answer_key":"y = 3x^2 + 6x - 5","accepted_answers":["y=3x^2+6x-5"],"diagnostic_tag":"expand_standard_form","tutor_behavior":"Expand, distribute, and combine constants."},
  {"id":"A6B-M01","type":"mastery_check","difficulty":"Foundational","prompt":"Write a quadratic with vertex (1,0) through (3,8).","answer_key":"y = 2(x - 1)^2","accepted_answers":["y=2(x-1)^2"],"diagnostic_tag":"solve_for_a","tutor_behavior":"Solve 8=4a."},
  {"id":"A6B-M02","type":"mastery_check","difficulty":"Grade-level","prompt":"Write a quadratic with vertex (-2,1) through (1,10).","answer_key":"y = (x + 2)^2 + 1","accepted_answers":["y=(x+2)^2+1","y=1(x+2)^2+1"],"diagnostic_tag":"vertex_sign","critical_misconception":true,"tutor_behavior":"Use x+2 and verify a=1."},
  {"id":"A6B-M03","type":"mastery_check","difficulty":"Grade-level","prompt":"Write a quadratic with vertex (2,5) through (0,-3).","answer_key":"y = -2(x - 2)^2 + 5","accepted_answers":["y=-2(x-2)^2+5"],"diagnostic_tag":"solve_for_a","critical_misconception":true,"tutor_behavior":"Solve -3=4a+5."},
  {"id":"A6B-M04","type":"mastery_check","difficulty":"Challenging","prompt":"Convert y=-2(x-3)^2+4 to standard form.","answer_key":"y = -2x^2 + 12x - 14","accepted_answers":["y=-2x^2+12x-14"],"diagnostic_tag":"expand_standard_form","critical_misconception":true,"tutor_behavior":"Preserve the negative scale during expansion."},
  {"id":"A6B-M05","type":"mastery_check","difficulty":"Reasoning","prompt":"A student uses vertex (4,-1) and writes y=a(x+4)^2-1. Write the correct template.","answer_key":"y = a(x - 4)^2 - 1","accepted_answers":["y=a(x-4)^2-1"],"diagnostic_tag":"vertex_sign","critical_misconception":true,"explanation_prompt":"Explain why the sign inside the parentheses is negative.","explanation_keywords":[["vertex","h"],["opposite","x-h","subtract"],["4"]],"minimum_explanation_keyword_groups":2,"explanation_guidance":"Vertex form uses x-h, so h=4 gives x-4.","tutor_behavior":"Require connection to x-h."},
  {"id":"A6B-X01","type":"depth_practice","difficulty":"Foundational","prompt":"Vertex (-4,2): write the vertex-form template.","answer_key":"y = a(x + 4)^2 + 2","accepted_answers":["y=a(x+4)^2+2"],"diagnostic_tag":"vertex_sign","critical_misconception":true,"tutor_behavior":"Use x-(-4)=x+4."},
  {"id":"A6B-X02","type":"depth_practice","difficulty":"Foundational","prompt":"If 6=a(2)^2-2, find a.","answer_key":"a = 2","accepted_answers":["a=2","2"],"diagnostic_tag":"solve_for_a","tutor_behavior":"Add 2 and divide by 4."},
  {"id":"A6B-X03","type":"depth_practice","difficulty":"Grade-level","prompt":"Vertex (3,4), point (5,0): find a.","answer_key":"a = -1","accepted_answers":["a=-1","-1"],"diagnostic_tag":"solve_for_a","tutor_behavior":"Solve 0=4a+4."},
  {"id":"A6B-X04","type":"depth_practice","difficulty":"Grade-level","prompt":"Write the quadratic with vertex (3,4) through (5,0).","answer_key":"y = -(x - 3)^2 + 4","accepted_answers":["y=-(x-3)^2+4"],"diagnostic_tag":"point_substitution","tutor_behavior":"Combine template and a=-1."},
  {"id":"A6B-X05","type":"depth_practice","difficulty":"Grade-level","prompt":"Write the quadratic with vertex (-2,-3) through (-4,5).","answer_key":"y = 2(x + 2)^2 - 3","accepted_answers":["y=2(x+2)^2-3"],"diagnostic_tag":"vertex_sign","tutor_behavior":"Use x+2 and solve 5=4a-3."},
  {"id":"A6B-X06","type":"depth_practice","difficulty":"Grade-level","prompt":"Convert y=(x-5)^2-9 to standard form.","answer_key":"y = x^2 - 10x + 16","accepted_answers":["y=x^2-10x+16"],"diagnostic_tag":"expand_standard_form","tutor_behavior":"Expand the binomial square correctly."},
  {"id":"A6B-X07","type":"depth_practice","difficulty":"Challenging","prompt":"Convert y=-3(x+2)^2+1 to standard form.","answer_key":"y = -3x^2 - 12x - 11","accepted_answers":["y=-3x^2-12x-11"],"diagnostic_tag":"expand_standard_form","critical_misconception":true,"tutor_behavior":"Distribute -3 before combining 1."},
  {"id":"A6B-X08","type":"depth_practice","difficulty":"Reasoning","prompt":"Does y=2(x-1)^2+3 have vertex (1,3)? Answer yes or no.","answer_key":"yes","accepted_answers":["Yes","YES"],"diagnostic_tag":"verify_vertex","tutor_behavior":"Read h and k directly."},
  {"id":"A6B-X09","type":"depth_practice","difficulty":"Reasoning","prompt":"Does y=(x+2)^2-4 pass through (0,0)? Answer yes or no.","answer_key":"yes","accepted_answers":["Yes","YES"],"diagnostic_tag":"verify_point","tutor_behavior":"Substitute x=0 and compare y."},
  {"id":"A6B-X10","type":"depth_practice","difficulty":"Reasoning","prompt":"A student substitutes point (4,7) into y=a(x-2)^2-1 as 4=a(7-2)^2-1. What values were swapped?","answer_key":"x and y","accepted_answers":["x and y were swapped","the x and y values"],"diagnostic_tag":"point_substitution","critical_misconception":true,"tutor_behavior":"Map ordered-pair coordinates to equation variables."},
  {"id":"A6B-X11","type":"depth_practice","difficulty":"Context","prompt":"A parabola has maximum vertex (2,9) and passes through (3,5). Find a.","answer_key":"a = -4","accepted_answers":["a=-4","-4"],"diagnostic_tag":"solve_for_a","tutor_behavior":"Solve 5=a(1)^2+9."},
  {"id":"A6B-X12","type":"depth_practice","difficulty":"Reasoning","prompt":"Why must a be negative when the vertex is a maximum? Answer briefly.","answer_key":"The parabola opens downward.","accepted_answers":["opens downward","it opens down"],"diagnostic_tag":"a_opening","tutor_behavior":"Connect the sign of a to opening direction."}
 ],
 "misconception_routes":{"vertex_sign":{"error_code":"A6B-E01","teacher_signal":"Uses the vertex x-coordinate with the wrong sign","route":"vertex-sign-remediation"},"point_substitution":{"error_code":"A6B-E02","teacher_signal":"Substitutes ordered-pair coordinates incorrectly","route":"point-substitution-remediation"},"solve_for_a":{"error_code":"A6B-E03","teacher_signal":"Cannot isolate the vertical scale factor","route":"solve-for-a-remediation"},"expand_standard_form":{"error_code":"A6B-E04","teacher_signal":"Expands or distributes vertex form incorrectly","route":"standard-form-expansion-remediation"},"verify_vertex":{"error_code":"A6B-E05","teacher_signal":"Cannot verify the stated vertex","route":"vertex-verification-remediation"},"verify_point":{"error_code":"A6B-E06","teacher_signal":"Cannot verify the second point","route":"point-verification-remediation"},"a_opening":{"error_code":"A6B-E07","teacher_signal":"Does not connect sign of a to opening","route":"opening-direction-remediation"}}
}
